{
  "file": "E:\\彬\\1026.mp4",
  "language": "zh",
  "duration": 314.63,
  "segments": [
    {
      "start": 0.0,
      "end": 2.24,
      "text": "原则性问题如何翻篇重来"
    },
    {
      "start": 2.24,
      "end": 3.84,
      "text": "我们提到原则性问题"
    },
    {
      "start": 3.84,
      "end": 6.16,
      "text": "大多数人第一反应是没法翻篇"
    },
    {
      "start": 6.16,
      "end": 7.36,
      "text": "无论是出轨"
    },
    {
      "start": 7.36,
      "end": 8.08,
      "text": "背叛"
    },
    {
      "start": 8.08,
      "end": 9.68,
      "text": "还是突破底下的欺骗"
    },
    {
      "start": 9.68,
      "end": 12.8,
      "text": "这些行为就像在关系里画下一道深沟"
    },
    {
      "start": 12.8,
      "end": 15.28,
      "text": "一边是被伤害者的破碎与怀疑"
    },
    {
      "start": 15.28,
      "end": 17.6,
      "text": "一边是犯错者的愧疚与挣扎"
    },
    {
      "start": 17.6,
      "end": 19.6,
      "text": "可现实里总有一些关系"
    },
    {
      "start": 19.6,
      "end": 21.28,
      "text": "在经历过原则性问题后"
    },
    {
      "start": 21.28,
      "end": 22.4,
      "text": "没有走向破裂"
    },
    {
      "start": 22.4,
      "end": 24.0,
      "text": "反而慢慢找回了温度"
    },
    {
      "start": 24.0,
      "end": 26.48,
      "text": "其实原则性问题的翻篇重来"
    },
    {
      "start": 26.48,
      "end": 28.24,
      "text": "从来不是假装没发生"
    },
    {
      "start": 28.24,
      "end": 29.84,
      "text": "也不是勉强原谅"
    },
    {
      "start": 29.92,
      "end": 31.44,
      "text": "而是两个人带着诚意"
    },
    {
      "start": 31.44,
      "end": 32.88,
      "text": "一起跨过几道坎"
    },
    {
      "start": 32.88,
      "end": 34.8,
      "text": "把破碎的关系重新拼起来"
    },
    {
      "start": 34.8,
      "end": 36.24,
      "text": "甚至拼得更牢固"
    },
    {
      "start": 36.24,
      "end": 37.28,
      "text": "首先要明确"
    },
    {
      "start": 37.28,
      "end": 38.56,
      "text": "原则性问题的翻篇"
    },
    {
      "start": 38.56,
      "end": 40.72,
      "text": "始于双方都想走下去的共识"
    },
    {
      "start": 40.72,
      "end": 42.24,
      "text": "如果只有一方想修复"
    },
    {
      "start": 42.24,
      "end": 44.16,
      "text": "另一方要么敷衍应付"
    },
    {
      "start": 44.16,
      "end": 45.36,
      "text": "要么心存侥幸"
    },
    {
      "start": 45.36,
      "end": 47.84,
      "text": "这段关系只会在反复拉扯中更恨苦"
    },
    {
      "start": 47.84,
      "end": 48.88,
      "text": "被伤害者"
    },
    {
      "start": 48.88,
      "end": 50.24,
      "text": "就要先问自己"
    },
    {
      "start": 50.24,
      "end": 51.6,
      "text": "我是真的想原谅"
    },
    {
      "start": 51.6,
      "end": 53.28,
      "text": "还是因为舍不得过去"
    },
    {
      "start": 53.28,
      "end": 55.52,
      "text": "怕面对未知才选择妥协"
    },
    {
      "start": 55.52,
      "end": 57.2,
      "text": "如果心里满是怨恨"
    },
    {
      "start": 57.2,
      "end": 58.88,
      "text": "只是强迫自己翻篇"
    },
    {
      "start": 58.96,
      "end": 60.72,
      "text": "只会在日后的相处中"
    },
    {
      "start": 60.72,
      "end": 62.08,
      "text": "风把这份怨恨"
    },
    {
      "start": 62.08,
      "end": 63.2,
      "text": "能变成刺"
    },
    {
      "start": 63.2,
      "end": 64.24,
      "text": "扎向对方"
    },
    {
      "start": 64.24,
      "end": 65.44,
      "text": "也扎向自己"
    },
    {
      "start": 65.44,
      "end": 66.96,
      "text": "而犯错者也要清醒"
    },
    {
      "start": 66.96,
      "end": 68.48,
      "text": "我是真的认识到错误"
    },
    {
      "start": 68.48,
      "end": 70.32,
      "text": "愿意付出长期努力一步"
    },
    {
      "start": 70.32,
      "end": 72.24,
      "text": "还是只想尽快平息矛盾"
    },
    {
      "start": 72.24,
      "end": 73.92,
      "text": "回到表面和平的状态"
    },
    {
      "start": 73.92,
      "end": 75.04,
      "text": "如果只是想过关"
    },
    {
      "start": 75.04,
      "end": 76.24,
      "text": "没有真正的回改"
    },
    {
      "start": 76.24,
      "end": 77.52,
      "text": "哪怕暂时和好了"
    },
    {
      "start": 77.52,
      "end": 78.4,
      "text": "原则性问题"
    },
    {
      "start": 78.4,
      "end": 79.92,
      "text": "大概率还会重演"
    },
    {
      "start": 79.92,
      "end": 81.04,
      "text": "只有当两个人都带着"
    },
    {
      "start": 81.04,
      "end": 82.56,
      "text": "想认真修复的决心"
    },
    {
      "start": 82.56,
      "end": 84.72,
      "text": "都愿意为这份关系再拼一次"
    },
    {
      "start": 84.72,
      "end": 86.16,
      "text": "翻篇才有了基础"
    },
    {
      "start": 86.16,
      "end": 87.04,
      "text": "接下来必须经历"
    },
    {
      "start": 87.04,
      "end": 88.56,
      "text": "不回避的深度复盘"
    },
    {
      "start": 88.88,
      "end": 90.88,
      "text": "最痛苦 却最关键的一步"
    },
    {
      "start": 90.88,
      "end": 92.16,
      "text": "很多人怕翻旧账"
    },
    {
      "start": 92.16,
      "end": 93.68,
      "text": "所以选择不提过去"
    },
    {
      "start": 93.68,
      "end": 95.36,
      "text": "可那些没被说特的委屈"
    },
    {
      "start": 95.36,
      "end": 96.64,
      "text": "没被重视的问题"
    },
    {
      "start": 96.64,
      "end": 98.0,
      "text": "只会在心里发酵"
    },
    {
      "start": 98.0,
      "end": 100.16,
      "text": "正确的复盘不是互相指责"
    },
    {
      "start": 100.16,
      "end": 101.44,
      "text": "而是旧事论事"
    },
    {
      "start": 101.44,
      "end": 103.2,
      "text": "被伤害者可以坦诚地说"
    },
    {
      "start": 103.2,
      "end": 103.92,
      "text": "你当时的行为"
    },
    {
      "start": 103.92,
      "end": 105.36,
      "text": "让我觉得自己像个笑话"
    },
    {
      "start": 105.36,
      "end": 107.12,
      "text": "我再也不敢相信任何人了"
    },
    {
      "start": 107.12,
      "end": 109.04,
      "text": "而不是你从来就没爱过我"
    },
    {
      "start": 109.04,
      "end": 110.88,
      "text": "犯错者要直面自己的问题"
    },
    {
      "start": 110.88,
      "end": 112.88,
      "text": "是我当时被欲望聪婚的头"
    },
    {
      "start": 112.88,
      "end": 114.16,
      "text": "忽略了你的感受"
    },
    {
      "start": 114.16,
      "end": 115.52,
      "text": "也辜负了你的信任"
    },
    {
      "start": 115.52,
      "end": 116.48,
      "text": "这是我的错"
    },
    {
      "start": 116.48,
      "end": 117.68,
      "text": "而不是找借口"
    },
    {
      "start": 117.68,
      "end": 119.2,
      "text": "当时我压力太大了"
    },
    {
      "start": 119.2,
      "end": 120.88,
      "text": "你那时候也对我也不好"
    },
    {
      "start": 120.88,
      "end": 123.04,
      "text": "复盘的目的不是要分禁谁更错"
    },
    {
      "start": 123.04,
      "end": 125.04,
      "text": "而是让两个人都看清这段关系"
    },
    {
      "start": 125.04,
      "end": 126.4,
      "text": "到底哪里出了问题"
    },
    {
      "start": 126.4,
      "end": 128.48,
      "text": "才让原则性问题有了可诚之机"
    },
    {
      "start": 128.48,
      "end": 129.92,
      "text": "是长期缺乏沟通"
    },
    {
      "start": 129.92,
      "end": 132.08,
      "text": "还是彼此的需求一直被忽视"
    },
    {
      "start": 132.08,
      "end": 133.68,
      "text": "是边界感模糊"
    },
    {
      "start": 133.68,
      "end": 135.76,
      "text": "还是对关系的重视程度不够"
    },
    {
      "start": 135.76,
      "end": 136.88,
      "text": "只有找到根源"
    },
    {
      "start": 136.88,
      "end": 138.4,
      "text": "才能在后续的相处中"
    },
    {
      "start": 138.4,
      "end": 139.68,
      "text": "比开曾经的坑"
    },
    {
      "start": 139.68,
      "end": 141.76,
      "text": "然后适用行动重建新人"
    },
    {
      "start": 141.76,
      "end": 143.84,
      "text": "这翻篇重来最漫长的过程"
    },
    {
      "start": 143.84,
      "end": 145.44,
      "text": "也是最需要耐心的一步"
    },
    {
      "start": 145.52,
      "end": 148.08,
      "text": "原则性问题打破的本质是信任体系"
    },
    {
      "start": 148.08,
      "end": 149.2,
      "text": "而信任的重建"
    },
    {
      "start": 149.2,
      "end": 150.4,
      "text": "从来不是靠我保证"
    },
    {
      "start": 150.4,
      "end": 152.32,
      "text": "再也不犯了的口头承诺"
    },
    {
      "start": 152.32,
      "end": 154.48,
      "text": "而是靠一天一间小事的积累"
    },
    {
      "start": 154.48,
      "end": 155.12,
      "text": "犯错者"
    },
    {
      "start": 155.12,
      "end": 157.04,
      "text": "要主动把透明化变成日常"
    },
    {
      "start": 157.04,
      "end": 158.48,
      "text": "比如主动分享行程"
    },
    {
      "start": 158.48,
      "end": 160.16,
      "text": "让对方随时能找到自己手机"
    },
    {
      "start": 160.16,
      "end": 161.2,
      "text": "是不是匿名"
    },
    {
      "start": 161.2,
      "end": 162.64,
      "text": "愿意让对方查看"
    },
    {
      "start": 162.64,
      "end": 164.56,
      "text": "再面对可能引发误会的场景时"
    },
    {
      "start": 164.56,
      "end": 165.52,
      "text": "提前沟通"
    },
    {
      "start": 165.52,
      "end": 167.92,
      "text": "比如今天要和异性同事一起加班"
    },
    {
      "start": 167.92,
      "end": 169.28,
      "text": "结束后我给你发视频"
    },
    {
      "start": 169.28,
      "end": 170.88,
      "text": "这些行为看似卑微"
    },
    {
      "start": 170.88,
      "end": 172.0,
      "text": "就是在一点点填补"
    },
    {
      "start": 172.0,
      "end": 174.16,
      "text": "被伤害者心里的安全感缺口"
    },
    {
      "start": 174.24,
      "end": 174.96,
      "text": "同时"
    },
    {
      "start": 174.96,
      "end": 178.08,
      "text": "犯错者还要记住被伤害者的情绪名感典"
    },
    {
      "start": 178.08,
      "end": 180.72,
      "text": "比如对方不喜欢自己和某个异性有联系"
    },
    {
      "start": 180.72,
      "end": 182.4,
      "text": "就主动切断所有关联"
    },
    {
      "start": 182.4,
      "end": 184.32,
      "text": "对方偶尔会提起过去的伤害"
    },
    {
      "start": 184.32,
      "end": 186.24,
      "text": "不要不耐烦的手都过去了"
    },
    {
      "start": 186.24,
      "end": 187.44,
      "text": "而是耐心倾听"
    },
    {
      "start": 187.44,
      "end": 188.64,
      "text": "用行动证明"
    },
    {
      "start": 188.64,
      "end": 190.08,
      "text": "我知道你还在痛"
    },
    {
      "start": 190.08,
      "end": 191.36,
      "text": "我会一直陪着你"
    },
    {
      "start": 191.36,
      "end": 194.24,
      "text": "而被伤害者也要试着给彼此失措空间"
    },
    {
      "start": 194.24,
      "end": 195.84,
      "text": "不是立刻完全信任"
    },
    {
      "start": 195.84,
      "end": 198.16,
      "text": "而是在看到对方持续的行动后"
    },
    {
      "start": 198.16,
      "end": 200.0,
      "text": "慢慢放松紧绷的防备"
    },
    {
      "start": 200.0,
      "end": 201.44,
      "text": "比如对方暗示回家"
    },
    {
      "start": 201.44,
      "end": 203.04,
      "text": "主动分享生活时"
    },
    {
      "start": 203.04,
      "end": 204.08,
      "text": "试着回应一句"
    },
    {
      "start": 204.08,
      "end": 204.88,
      "text": "辛苦了"
    },
    {
      "start": 204.88,
      "end": 206.16,
      "text": "而不是一直冷着"
    },
    {
      "start": 206.16,
      "end": 208.32,
      "text": "信任的重建就像攒钱"
    },
    {
      "start": 208.32,
      "end": 209.36,
      "text": "一天攒一点"
    },
    {
      "start": 209.36,
      "end": 210.88,
      "text": "慢慢就会稀少成多"
    },
    {
      "start": 210.88,
      "end": 212.24,
      "text": "可一旦有一次失信"
    },
    {
      "start": 212.24,
      "end": 213.76,
      "text": "可能就会回到原点"
    },
    {
      "start": 213.76,
      "end": 215.6,
      "text": "所以两个人都要格外珍惜"
    },
    {
      "start": 215.6,
      "end": 216.24,
      "text": "最后"
    },
    {
      "start": 216.24,
      "end": 217.68,
      "text": "原则性问题的翻篇"
    },
    {
      "start": 217.68,
      "end": 219.04,
      "text": "需要时间的沉淀"
    },
    {
      "start": 219.04,
      "end": 220.56,
      "text": "和关系模式的重塑"
    },
    {
      "start": 220.56,
      "end": 222.32,
      "text": "很多人以为只要道歉"
    },
    {
      "start": 222.32,
      "end": 222.96,
      "text": "断脸"
    },
    {
      "start": 222.96,
      "end": 224.96,
      "text": "做些补偿就能翻篇"
    },
    {
      "start": 224.96,
      "end": 225.92,
      "text": "可实际上"
    },
    {
      "start": 225.92,
      "end": 227.44,
      "text": "旧的关系模式不改变"
    },
    {
      "start": 227.44,
      "end": 229.12,
      "text": "问题还会重复出现"
    },
    {
      "start": 229.12,
      "end": 231.28,
      "text": "比如之前两个人因为缺乏沟通"
    },
    {
      "start": 231.28,
      "end": 232.48,
      "text": "导致矛盾积累"
    },
    {
      "start": 232.56,
      "end": 234.32,
      "text": "最终引发原则性问题"
    },
    {
      "start": 234.32,
      "end": 235.52,
      "text": "那么三天后就要建立"
    },
    {
      "start": 235.52,
      "end": 236.96,
      "text": "新的沟通模式"
    },
    {
      "start": 236.96,
      "end": 238.24,
      "text": "每天聊十分钟"
    },
    {
      "start": 238.24,
      "end": 239.68,
      "text": "聊聊彼此的心情"
    },
    {
      "start": 239.68,
      "end": 241.28,
      "text": "遇到问题时不冷战"
    },
    {
      "start": 241.28,
      "end": 242.16,
      "text": "不指责"
    },
    {
      "start": 242.16,
      "end": 243.04,
      "text": "而是说"
    },
    {
      "start": 243.04,
      "end": 244.48,
      "text": "我现在有点难受"
    },
    {
      "start": 244.48,
      "end": 246.08,
      "text": "我们能不能好好说说"
    },
    {
      "start": 246.08,
      "end": 246.88,
      "text": "再比如"
    },
    {
      "start": 246.88,
      "end": 247.84,
      "text": "之前犯了错"
    },
    {
      "start": 247.84,
      "end": 249.12,
      "text": "因为边界感模糊"
    },
    {
      "start": 249.12,
      "end": 250.0,
      "text": "出了问题"
    },
    {
      "start": 250.0,
      "end": 251.76,
      "text": "三天后就要一起明确"
    },
    {
      "start": 251.76,
      "end": 253.68,
      "text": "什么是彼此能接受的边界"
    },
    {
      "start": 253.68,
      "end": 255.6,
      "text": "比如不单独和疫情示范"
    },
    {
      "start": 255.6,
      "end": 257.52,
      "text": "不隐瞒重要的社交活动"
    },
    {
      "start": 257.52,
      "end": 258.24,
      "text": "同时"
    },
    {
      "start": 258.24,
      "end": 260.24,
      "text": "两个人也要一起做一些新的事"
    },
    {
      "start": 260.24,
      "end": 261.52,
      "text": "比如一起去旅行"
    },
    {
      "start": 261.52,
      "end": 262.72,
      "text": "创造新的回忆"
    },
    {
      "start": 262.72,
      "end": 264.56,
      "text": "一起培养一个共同的爱好"
    },
    {
      "start": 264.56,
      "end": 266.08,
      "text": "增加彼此的连结"
    },
    {
      "start": 266.08,
      "end": 267.04,
      "text": "这些新的经历"
    },
    {
      "start": 267.04,
      "end": 268.72,
      "text": "会慢慢覆盖过去的伤痛"
    },
    {
      "start": 268.72,
      "end": 270.32,
      "text": "产生新的生长点"
    },
    {
      "start": 270.32,
      "end": 272.0,
      "text": "其实原则性问题的翻篇"
    },
    {
      "start": 272.0,
      "end": 273.68,
      "text": "从来不是一件容易的事"
    },
    {
      "start": 273.68,
      "end": 274.8,
      "text": "它需要被伤害者"
    },
    {
      "start": 274.8,
      "end": 276.32,
      "text": "放下受害者的身份"
    },
    {
      "start": 276.32,
      "end": 277.68,
      "text": "不再沉溺于痛苦"
    },
    {
      "start": 277.68,
      "end": 279.92,
      "text": "也需要犯错者放下侥幸的心理"
    },
    {
      "start": 279.92,
      "end": 281.52,
      "text": "真正用行动弥补"
    },
    {
      "start": 281.52,
      "end": 283.68,
      "text": "这个过程里会有情绪的反复"
    },
    {
      "start": 283.68,
      "end": 285.04,
      "text": "会有怀疑的时刻"
    },
    {
      "start": 285.04,
      "end": 286.96,
      "text": "甚至会有要不放弃的念头"
    },
    {
      "start": 286.96,
      "end": 288.24,
      "text": "这些都是正常的"
    },
    {
      "start": 288.24,
      "end": 289.92,
      "text": "但只要两个人都没放弃"
    },
    {
      "start": 289.92,
      "end": 291.44,
      "text": "都在为这份关系努力"
    },
    {
      "start": 291.6,
      "end": 292.96,
      "text": "就有可能让破碎"
    },
    {
      "start": 292.96,
      "end": 294.08,
      "text": "变成重生"
    },
    {
      "start": 294.08,
      "end": 294.72,
      "text": "毕竟"
    },
    {
      "start": 294.72,
      "end": 296.32,
      "text": "一旦经历过考验的关系"
    },
    {
      "start": 296.32,
      "end": 297.76,
      "text": "若能重新走到一起"
    },
    {
      "start": 297.76,
      "end": 299.44,
      "text": "彼此都会更懂珍惜"
    },
    {
      "start": 299.44,
      "end": 301.28,
      "text": "也会更清楚什么样的相处"
    },
    {
      "start": 301.28,
      "end": 302.72,
      "text": "才能让关系长久"
    },
    {
      "start": 302.72,
      "end": 303.44,
      "text": "而这"
    },
    {
      "start": 303.44,
      "end": 304.88,
      "text": "或许就是原则性问题"
    },
    {
      "start": 304.88,
      "end": 306.16,
      "text": "带来的意外收获"
    },
    {
      "start": 306.16,
      "end": 308.32,
      "text": "不是所有伤害都会留下疤痕"
    },
    {
      "start": 308.32,
      "end": 310.56,
      "text": "有些伤害会让关系变得更坚韧"
    },
    {
      "start": 310.56,
      "end": 311.36,
      "text": "我是李安"
    },
    {
      "start": 311.36,
      "end": 313.12,
      "text": "十年家庭会因自寻师"
    },
    {
      "start": 313.12,
      "end": 314.56,
      "text": "我很乐意和大家聊聊"
    }
  ]
}