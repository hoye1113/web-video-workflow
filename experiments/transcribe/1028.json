{
  "file": "E:\\彬\\1028.mp4",
  "language": "zh",
  "duration": 269.37,
  "segments": [
    {
      "start": 0.0,
      "end": 2.52,
      "text": "堅決離婚的人在等你修復婚姻"
    },
    {
      "start": 2.52,
      "end": 3.72,
      "text": "無奈你也不會"
    },
    {
      "start": 3.72,
      "end": 5.16,
      "text": "大家好 我是李安"
    },
    {
      "start": 5.16,
      "end": 7.92,
      "text": "一個專注修復的婚姻家庭諮詢師"
    },
    {
      "start": 7.92,
      "end": 10.08,
      "text": "無論有著多麼奇葩的婚姻認知"
    },
    {
      "start": 10.08,
      "end": 12.72,
      "text": "這世上就沒有人主動想去做離婚的人"
    },
    {
      "start": 12.72,
      "end": 13.4,
      "text": "當然"
    },
    {
      "start": 13.4,
      "end": 16.04,
      "text": "也包括此刻正在逼你離婚的伴侶"
    },
    {
      "start": 16.04,
      "end": 18.16,
      "text": "其內心深處最想要的是"
    },
    {
      "start": 18.16,
      "end": 19.76,
      "text": "現有的婚姻能逆轉乘"
    },
    {
      "start": 19.76,
      "end": 20.84,
      "text": "她願意留下"
    },
    {
      "start": 20.84,
      "end": 22.6,
      "text": "能讓她感到幸福的模樣"
    },
    {
      "start": 22.6,
      "end": 24.04,
      "text": "而之所以現實裡"
    },
    {
      "start": 24.04,
      "end": 26.24,
      "text": "對方呈現出來的是很心絕情"
    },
    {
      "start": 26.24,
      "end": 27.16,
      "text": "非離不可"
    },
    {
      "start": 27.16,
      "end": 29.24,
      "text": "那是因為婚姻構成所設計的人"
    },
    {
      "start": 29.32,
      "end": 30.64,
      "text": "事務實在太多了"
    },
    {
      "start": 30.64,
      "end": 33.16,
      "text": "並且過往婚姻已經生成的真實經歷"
    },
    {
      "start": 33.16,
      "end": 34.64,
      "text": "以及目前的認知水平"
    },
    {
      "start": 34.64,
      "end": 36.08,
      "text": "能得到的決論就是"
    },
    {
      "start": 36.08,
      "end": 38.2,
      "text": "要讓婚姻轉變到自己滿意"
    },
    {
      "start": 38.2,
      "end": 39.64,
      "text": "根本不可能實現"
    },
    {
      "start": 39.64,
      "end": 42.16,
      "text": "被離得你是不是覺得現在的自己"
    },
    {
      "start": 42.16,
      "end": 44.48,
      "text": "好像能夠接受對方提出的所有要求"
    },
    {
      "start": 44.48,
      "end": 46.4,
      "text": "與對方而言並不存在困難"
    },
    {
      "start": 46.4,
      "end": 48.12,
      "text": "只要對方肯放棄離婚"
    },
    {
      "start": 48.12,
      "end": 49.24,
      "text": "什麼都好說"
    },
    {
      "start": 49.24,
      "end": 50.84,
      "text": "可你怕離婚的慌亂"
    },
    {
      "start": 50.84,
      "end": 52.68,
      "text": "對方是能清晰感居到的"
    },
    {
      "start": 52.68,
      "end": 54.32,
      "text": "對方比你更理性地看到你"
    },
    {
      "start": 54.32,
      "end": 55.72,
      "text": "當下的失落銀河"
    },
    {
      "start": 55.72,
      "end": 57.88,
      "text": "全都源於那份怕離婚的恐懼"
    },
    {
      "start": 57.92,
      "end": 59.08,
      "text": "一旦風波過去"
    },
    {
      "start": 59.08,
      "end": 60.48,
      "text": "以對方對你的了解"
    },
    {
      "start": 60.48,
      "end": 61.4,
      "text": "你很快"
    },
    {
      "start": 61.4,
      "end": 63.24,
      "text": "就會恢復成那個與其作對"
    },
    {
      "start": 63.24,
      "end": 64.68,
      "text": "時期痛苦的角色"
    },
    {
      "start": 64.68,
      "end": 65.96,
      "text": "你可能很有信心"
    },
    {
      "start": 65.96,
      "end": 67.68,
      "text": "對方完全可以先試一試"
    },
    {
      "start": 67.68,
      "end": 69.72,
      "text": "如果自己真的像對方說的那樣"
    },
    {
      "start": 69.72,
      "end": 70.88,
      "text": "寵到負責"
    },
    {
      "start": 70.88,
      "end": 72.08,
      "text": "到那時再離婚"
    },
    {
      "start": 72.08,
      "end": 73.04,
      "text": "不也不遲"
    },
    {
      "start": 73.04,
      "end": 74.4,
      "text": "然而你不知道的是"
    },
    {
      "start": 74.4,
      "end": 76.72,
      "text": "對方和你的婚姻存續了多少天"
    },
    {
      "start": 76.72,
      "end": 77.68,
      "text": "在對方的感受裏"
    },
    {
      "start": 77.68,
      "end": 79.64,
      "text": "就已經嘗試過多少次"
    },
    {
      "start": 79.64,
      "end": 80.6,
      "text": "因此"
    },
    {
      "start": 80.6,
      "end": 82.36,
      "text": "哪怕你們才結婚幾個月"
    },
    {
      "start": 82.36,
      "end": 84.04,
      "text": "都有可能被對方的現有認知"
    },
    {
      "start": 84.04,
      "end": 85.24,
      "text": "判定為夠了"
    },
    {
      "start": 85.24,
      "end": 86.44,
      "text": "已經到達極限"
    },
    {
      "start": 86.44,
      "end": 88.4,
      "text": "繼續嘗試只會徒增痛苦"
    },
    {
      "start": 88.4,
      "end": 90.24,
      "text": "浪費更多生命時間"
    },
    {
      "start": 90.24,
      "end": 91.24,
      "text": "在對方眼中"
    },
    {
      "start": 91.24,
      "end": 92.56,
      "text": "逆轉婚姻現狀的男人"
    },
    {
      "start": 92.56,
      "end": 94.36,
      "text": "遠不只在你這個配偶身上"
    },
    {
      "start": 94.36,
      "end": 95.52,
      "text": "更絕望的是"
    },
    {
      "start": 95.52,
      "end": 97.4,
      "text": "很多給他帶去痛苦的因素"
    },
    {
      "start": 97.4,
      "end": 98.56,
      "text": "在你的生命中"
    },
    {
      "start": 98.56,
      "end": 100.24,
      "text": "已經存在了幾十年"
    },
    {
      "start": 100.24,
      "end": 103.4,
      "text": "甚至就是造就你現有現狀的構成要件"
    },
    {
      "start": 103.4,
      "end": 105.24,
      "text": "這裡面所涉及的人事物"
    },
    {
      "start": 105.24,
      "end": 106.92,
      "text": "即便你真的有心改變"
    },
    {
      "start": 106.92,
      "end": 107.8,
      "text": "現實裏"
    },
    {
      "start": 107.8,
      "end": 109.4,
      "text": "你也絕對無力改變"
    },
    {
      "start": 109.4,
      "end": 110.32,
      "text": "不敢改變"
    },
    {
      "start": 110.32,
      "end": 111.92,
      "text": "做不出更做不到"
    },
    {
      "start": 111.92,
      "end": 113.84,
      "text": "就算你很膚淺 很自私"
    },
    {
      "start": 113.84,
      "end": 116.04,
      "text": "為了盡快擺脫怕離婚的痛苦"
    },
    {
      "start": 116.08,
      "end": 117.4,
      "text": "硬逼自己去做"
    },
    {
      "start": 117.4,
      "end": 119.32,
      "text": "可對方卻完全不想背負"
    },
    {
      "start": 119.32,
      "end": 121.84,
      "text": "那份由此可能產生的不安和愧疚"
    },
    {
      "start": 121.84,
      "end": 123.04,
      "text": "關於這一點"
    },
    {
      "start": 123.04,
      "end": 125.12,
      "text": "你說的一切都是你自己想做"
    },
    {
      "start": 125.12,
      "end": 126.8,
      "text": "但與對方無關的承諾"
    },
    {
      "start": 126.8,
      "end": 128.36,
      "text": "對方是萬分抗拒"
    },
    {
      "start": 128.36,
      "end": 129.8,
      "text": "卻無法相信的"
    },
    {
      "start": 129.8,
      "end": 131.4,
      "text": "因為對方太清楚了"
    },
    {
      "start": 131.4,
      "end": 132.48,
      "text": "你此時的激進"
    },
    {
      "start": 132.48,
      "end": 134.36,
      "text": "根本不是你的真實內心"
    },
    {
      "start": 134.36,
      "end": 135.2,
      "text": "更何況"
    },
    {
      "start": 135.2,
      "end": 137.36,
      "text": "那其中的人事物有很多"
    },
    {
      "start": 137.36,
      "end": 138.8,
      "text": "你啞根就做不了主"
    },
    {
      "start": 138.8,
      "end": 140.56,
      "text": "他們一天沒有徹底消失"
    },
    {
      "start": 140.56,
      "end": 141.52,
      "text": "就總有一天"
    },
    {
      "start": 141.52,
      "end": 143.68,
      "text": "你會重新和他們站到同一戰線的"
    },
    {
      "start": 143.68,
      "end": 144.68,
      "text": "背離的你"
    },
    {
      "start": 144.68,
      "end": 146.4,
      "text": "是不是覺得對方很自私"
    },
    {
      "start": 146.4,
      "end": 147.56,
      "text": "憑什麼婚姻要維持"
    },
    {
      "start": 147.56,
      "end": 148.96,
      "text": "就全都得勝你去世"
    },
    {
      "start": 148.96,
      "end": 150.0,
      "text": "因對方呢"
    },
    {
      "start": 150.0,
      "end": 150.92,
      "text": "不好意思"
    },
    {
      "start": 150.92,
      "end": 152.28,
      "text": "對方就是已經醒悟自己"
    },
    {
      "start": 152.28,
      "end": 153.76,
      "text": "做不到與你融合"
    },
    {
      "start": 153.76,
      "end": 154.52,
      "text": "沒辦法了"
    },
    {
      "start": 154.52,
      "end": 155.68,
      "text": "才選擇離婚的"
    },
    {
      "start": 155.68,
      "end": 157.16,
      "text": "你不用高看自己"
    },
    {
      "start": 157.16,
      "end": 159.2,
      "text": "對方和你的心路歷程是一樣的"
    },
    {
      "start": 159.2,
      "end": 161.08,
      "text": "只不過你還停留在恐懼離婚"
    },
    {
      "start": 161.08,
      "end": 162.12,
      "text": "未知的階段"
    },
    {
      "start": 162.12,
      "end": 164.0,
      "text": "而對方已經過了這個階段"
    },
    {
      "start": 164.0,
      "end": 165.16,
      "text": "所以背離的你"
    },
    {
      "start": 165.16,
      "end": 167.0,
      "text": "請立刻糾正你的錯誤思維"
    },
    {
      "start": 167.0,
      "end": 167.72,
      "text": "對方"
    },
    {
      "start": 167.72,
      "end": 168.96,
      "text": "並不是天然就和你形成"
    },
    {
      "start": 168.96,
      "end": 170.52,
      "text": "離譽不離的立場對抗"
    },
    {
      "start": 170.52,
      "end": 172.52,
      "text": "應該說對方最底層的立場"
    },
    {
      "start": 172.52,
      "end": 174.4,
      "text": "也是希望婚姻能夠存虛下去的"
    },
    {
      "start": 174.44,
      "end": 175.2,
      "text": "只不過"
    },
    {
      "start": 175.2,
      "end": 176.76,
      "text": "她要的婚姻存虛"
    },
    {
      "start": 176.76,
      "end": 178.64,
      "text": "已經不再是單純被情緒裹脅的"
    },
    {
      "start": 178.64,
      "end": 179.72,
      "text": "無腦對抗"
    },
    {
      "start": 179.72,
      "end": 181.16,
      "text": "而是婚姻要存虛"
    },
    {
      "start": 181.16,
      "end": 183.64,
      "text": "自己就必須能幸福的現實現狀"
    },
    {
      "start": 183.64,
      "end": 185.4,
      "text": "你的內心挽回心境"
    },
    {
      "start": 185.4,
      "end": 187.2,
      "text": "動搖不了對方離婚的決心"
    },
    {
      "start": 187.2,
      "end": 188.8,
      "text": "真不是對方鐵是心腸"
    },
    {
      "start": 188.8,
      "end": 189.96,
      "text": "狠心絕情"
    },
    {
      "start": 189.96,
      "end": 192.36,
      "text": "而是對方在其現有認知範圍內"
    },
    {
      "start": 192.36,
      "end": 193.72,
      "text": "已經通過努力"
    },
    {
      "start": 193.72,
      "end": 194.44,
      "text": "客觀"
    },
    {
      "start": 194.44,
      "end": 196.64,
      "text": "確認自己無法做到繼續婚姻"
    },
    {
      "start": 196.64,
      "end": 197.96,
      "text": "又能得到幸福"
    },
    {
      "start": 197.96,
      "end": 200.36,
      "text": "本來是既望你有她意料之外的神技"
    },
    {
      "start": 200.36,
      "end": 201.72,
      "text": "能解決這個難題"
    },
    {
      "start": 201.72,
      "end": 203.36,
      "text": "誰知你所呈現的水平"
    },
    {
      "start": 203.4,
      "end": 205.52,
      "text": "比她自己嘗試過的還要低級"
    },
    {
      "start": 205.52,
      "end": 207.44,
      "text": "總結起來就是無能"
    },
    {
      "start": 207.44,
      "end": 208.28,
      "text": "沒耐心"
    },
    {
      "start": 208.28,
      "end": 209.48,
      "text": "自私怕離"
    },
    {
      "start": 209.48,
      "end": 211.92,
      "text": "從頭到尾都透露著一種無賴起息"
    },
    {
      "start": 211.92,
      "end": 213.48,
      "text": "妄想僅靠言語"
    },
    {
      "start": 213.48,
      "end": 214.72,
      "text": "靠實而瘋狂"
    },
    {
      "start": 214.72,
      "end": 216.2,
      "text": "實而悲慘的演繹"
    },
    {
      "start": 216.2,
      "end": 217.76,
      "text": "只要對方無故委屈"
    },
    {
      "start": 217.76,
      "end": 219.28,
      "text": "自己先放棄離婚"
    },
    {
      "start": 219.28,
      "end": 220.48,
      "text": "而得到的結果"
    },
    {
      "start": 220.48,
      "end": 223.24,
      "text": "又僅僅只是讓你不用再被壞情緒折磨"
    },
    {
      "start": 223.24,
      "end": 224.84,
      "text": "所以真想留住對方"
    },
    {
      "start": 224.84,
      "end": 227.0,
      "text": "就一直住那個空虛內耗的自己"
    },
    {
      "start": 227.0,
      "end": 227.92,
      "text": "不要再拿著空氣"
    },
    {
      "start": 227.92,
      "end": 229.76,
      "text": "去和對方發生各種聯繫"
    },
    {
      "start": 229.76,
      "end": 230.8,
      "text": "行動起來"
    },
    {
      "start": 230.8,
      "end": 232.24,
      "text": "該換工作換工作"
    },
    {
      "start": 232.24,
      "end": 233.48,
      "text": "該搬家搬家"
    },
    {
      "start": 233.48,
      "end": 234.88,
      "text": "盡自己的極限去"
    },
    {
      "start": 234.88,
      "end": 236.44,
      "text": "讓影響婚姻的人事物"
    },
    {
      "start": 236.44,
      "end": 238.24,
      "text": "都真真切切地發生改變"
    },
    {
      "start": 238.24,
      "end": 240.2,
      "text": "不要給修復婚姻設定時間"
    },
    {
      "start": 240.2,
      "end": 242.44,
      "text": "也不要去干涉對方的思想行動"
    },
    {
      "start": 242.44,
      "end": 244.2,
      "text": "就算對方在霧色下架"
    },
    {
      "start": 244.2,
      "end": 245.48,
      "text": "也沒什麼好擔心的"
    },
    {
      "start": 245.48,
      "end": 246.8,
      "text": "當你在用事實改變"
    },
    {
      "start": 246.8,
      "end": 247.88,
      "text": "時間漸遠"
    },
    {
      "start": 247.88,
      "end": 249.16,
      "text": "你就一定會成長"
    },
    {
      "start": 249.16,
      "end": 251.28,
      "text": "只要走在正確修復婚姻的路上"
    },
    {
      "start": 251.28,
      "end": 252.36,
      "text": "最終的結局"
    },
    {
      "start": 252.36,
      "end": 253.44,
      "text": "就一定不差"
    },
    {
      "start": 253.44,
      "end": 254.92,
      "text": "通常是對方和你的"
    },
    {
      "start": 254.92,
      "end": 255.76,
      "text": "夫妻關係"
    },
    {
      "start": 255.76,
      "end": 256.72,
      "text": "會比婚姻未計前"
    },
    {
      "start": 256.72,
      "end": 258.16,
      "text": "更健康更親密"
    },
    {
      "start": 258.16,
      "end": 259.52,
      "text": "如果不是這個結局"
    },
    {
      "start": 259.52,
      "end": 261.52,
      "text": "也絕不會是你被拋棄的悲劇"
    },
    {
      "start": 261.52,
      "end": 262.68,
      "text": "而是你會很安心"
    },
    {
      "start": 262.68,
      "end": 263.64,
      "text": "很安寧"
    },
    {
      "start": 263.64,
      "end": 265.52,
      "text": "對方配不上成長後的你"
    },
    {
      "start": 265.52,
