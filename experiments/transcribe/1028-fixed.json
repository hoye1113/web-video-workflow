{
  "file": "E:\\彬\\1028.mp4",
  "language": "zh",
  "duration": 269.37,
  "segments": [
    {
      "start": 0.0,
      "end": 2.52,
      "text": "坚决离婚的人，在等你修复婚姻"
    },
    {
      "start": 2.52,
      "end": 3.72,
      "text": "可惜你也不会"
    },
    {
      "start": 3.72,
      "end": 5.16,
      "text": "大家好 我是李安"
    },
    {
      "start": 5.16,
      "end": 7.92,
      "text": "一个专注修复的婚姻家庭咨询师"
    },
    {
      "start": 7.92,
      "end": 10.08,
      "text": "无论有着多么奇葩的婚姻认知"
    },
    {
      "start": 10.08,
      "end": 12.72,
      "text": "这世上就没有人主动想去做离婚的人"
    },
    {
      "start": 12.72,
      "end": 13.4,
      "text": "当然"
    },
    {
      "start": 13.4,
      "end": 16.04,
      "text": "也包括此刻正在逼你离婚的伴侣"
    },
    {
      "start": 16.04,
      "end": 18.16,
      "text": "其内心深处最想要的是"
    },
    {
      "start": 18.16,
      "end": 19.76,
      "text": "现有的婚姻能逆转成"
    },
    {
      "start": 19.76,
      "end": 20.84,
      "text": "她愿意留下"
    },
    {
      "start": 20.84,
      "end": 22.6,
      "text": "能让她感到幸福的模样"
    },
    {
      "start": 22.6,
      "end": 24.04,
      "text": "而之所以现实里"
    },
    {
      "start": 24.04,
      "end": 26.24,
      "text": "对方呈现出来的，是狠心绝情"
    },
    {
      "start": 26.24,
      "end": 27.16,
      "text": "非离不可"
    },
    {
      "start": 27.16,
      "end": 29.24,
      "text": "那是因为婚姻构成所涉及的人"
    },
    {
      "start": 29.32,
      "end": 30.64,
      "text": "事务实在太多了"
    },
    {
      "start": 30.64,
      "end": 33.16,
      "text": "并且过往婚姻已经生成的真实经历"
    },
    {
      "start": 33.16,
      "end": 34.64,
      "text": "以及目前的认知水平"
    },
    {
      "start": 34.64,
      "end": 36.08,
      "text": "能得到的结论就是"
    },
    {
      "start": 36.08,
      "end": 38.2,
      "text": "要让婚姻转变到自己满意"
    },
    {
      "start": 38.2,
      "end": 39.64,
      "text": "根本不可能实现"
    },
    {
      "start": 39.64,
      "end": 42.16,
      "text": "被离婚的你，是不是觉得现在的自己"
    },
    {
      "start": 42.16,
      "end": 44.48,
      "text": "好像能够接受对方提出的所有要求"
    },
    {
      "start": 44.48,
      "end": 46.4,
      "text": "与对方而言并不存在困难"
    },
    {
      "start": 46.4,
      "end": 48.12,
      "text": "只要对方肯放弃离婚"
    },
    {
      "start": 48.12,
      "end": 49.24,
      "text": "什么都好说"
    },
    {
      "start": 49.24,
      "end": 50.84,
      "text": "可你怕离婚的慌乱"
    },
    {
      "start": 50.84,
      "end": 52.68,
      "text": "对方是能清晰感知到的"
    },
    {
      "start": 52.68,
      "end": 54.32,
      "text": "对方比你更理性地看到你"
    },
    {
      "start": 54.32,
      "end": 55.72,
      "text": "你当下的失落、迎合"
    },
    {
      "start": 55.72,
      "end": 57.88,
      "text": "全都源于那份怕离婚的恐惧"
    },
    {
      "start": 57.92,
      "end": 59.08,
      "text": "一旦风波过去"
    },
    {
      "start": 59.08,
      "end": 60.48,
      "text": "以对方对你的了解"
    },
    {
      "start": 60.48,
      "end": 61.4,
      "text": "你很快"
    },
    {
      "start": 61.4,
      "end": 63.24,
      "text": "就会恢复成那个与其作对"
    },
    {
      "start": 63.24,
      "end": 64.68,
      "text": "使你痛苦的角色"
    },
    {
      "start": 64.68,
      "end": 65.96,
      "text": "你可能很有信心"
    },
    {
      "start": 65.96,
      "end": 67.68,
      "text": "对方完全可以先试一试"
    },
    {
      "start": 67.68,
      "end": 69.72,
      "text": "如果自己真的像对方说的那样"
    },
    {
      "start": 69.72,
      "end": 70.88,
      "text": "重蹈覆辙"
    },
    {
      "start": 70.88,
      "end": 72.08,
      "text": "到那时再离婚"
    },
    {
      "start": 72.08,
      "end": 73.04,
      "text": "不也不迟"
    },
    {
      "start": 73.04,
      "end": 74.4,
      "text": "然而你不知道的是"
    },
    {
      "start": 74.4,
      "end": 76.72,
      "text": "对方和你的婚姻存续了多少天"
    },
    {
      "start": 76.72,
      "end": 77.68,
      "text": "在对方的感受里"
    },
    {
      "start": 77.68,
      "end": 79.64,
      "text": "就已经尝试过多少次"
    },
    {
      "start": 79.64,
      "end": 80.6,
      "text": "因此"
    },
    {
      "start": 80.6,
      "end": 82.36,
      "text": "哪怕你们才结婚几个月"
    },
    {
      "start": 82.36,
      "end": 84.04,
      "text": "都有可能被对方的现有认知"
    },
    {
      "start": 84.04,
      "end": 85.24,
      "text": "判定为够了"
    },
    {
      "start": 85.24,
      "end": 86.44,
      "text": "已经到达极限"
    },
    {
      "start": 86.44,
      "end": 88.4,
      "text": "继续尝试只会徒增痛苦"
    },
    {
      "start": 88.4,
      "end": 90.24,
      "text": "浪费更多生命时间"
    },
    {
      "start": 90.24,
      "end": 91.24,
      "text": "在对方眼中"
    },
    {
      "start": 91.24,
      "end": 92.56,
      "text": "逆转婚姻现状的男人"
    },
    {
      "start": 92.56,
      "end": 94.36,
      "text": "远不只在你这个配偶身上"
    },
    {
      "start": 94.36,
      "end": 95.52,
      "text": "更绝望的是"
    },
    {
      "start": 95.52,
      "end": 97.4,
      "text": "很多给他带去痛苦的因素"
    },
    {
      "start": 97.4,
      "end": 98.56,
      "text": "在你的生命中"
    },
    {
      "start": 98.56,
      "end": 100.24,
      "text": "已经存在了几十年"
    },
    {
      "start": 100.24,
      "end": 103.4,
      "text": "甚至就是造就你现有现状的构成要件"
    },
    {
      "start": 103.4,
      "end": 105.24,
      "text": "这里面所涉及的人事物"
    },
    {
      "start": 105.24,
      "end": 106.92,
      "text": "即便你真的有心改变"
    },
    {
      "start": 106.92,
      "end": 107.8,
      "text": "现实里"
    },
    {
      "start": 107.8,
      "end": 109.4,
      "text": "你也绝对无力改变"
    },
    {
      "start": 109.4,
      "end": 110.32,
      "text": "不敢改变"
    },
    {
      "start": 110.32,
      "end": 111.92,
      "text": "做不出更做不到"
    },
    {
      "start": 111.92,
      "end": 113.84,
      "text": "就算你很肤浅 很自私"
    },
    {
      "start": 113.84,
      "end": 116.04,
      "text": "为了尽快摆脱怕离婚的痛苦"
    },
    {
      "start": 116.08,
      "end": 117.4,
      "text": "硬逼自己去做"
    },
    {
      "start": 117.4,
      "end": 119.32,
      "text": "可对方却完全不想背负"
    },
    {
      "start": 119.32,
      "end": 121.84,
      "text": "那份由此可能产生的不安和愧疚"
    },
    {
      "start": 121.84,
      "end": 123.04,
      "text": "关于这一点"
    },
    {
      "start": 123.04,
      "end": 125.12,
      "text": "你说的一切都是你自己想做"
    },
    {
      "start": 125.12,
      "end": 126.8,
      "text": "但与对方无关的承诺"
    },
    {
      "start": 126.8,
      "end": 128.36,
      "text": "对方是万分抗拒"
    },
    {
      "start": 128.36,
      "end": 129.8,
      "text": "却无法相信的"
    },
    {
      "start": 129.8,
      "end": 131.4,
      "text": "因为对方太清楚了"
    },
    {
      "start": 131.4,
      "end": 132.48,
      "text": "你此时的激进"
    },
    {
      "start": 132.48,
      "end": 134.36,
      "text": "根本不是你的真实内心"
    },
    {
      "start": 134.36,
      "end": 135.2,
      "text": "更何况"
    },
    {
      "start": 135.2,
      "end": 137.36,
      "text": "那其中的人事物有很多"
    },
    {
      "start": 137.36,
      "end": 138.8,
      "text": "你压根就做不了主"
    },
    {
      "start": 138.8,
      "end": 140.56,
      "text": "他们一天没有彻底消失"
    },
    {
      "start": 140.56,
      "end": 141.52,
      "text": "就总有一天"
    },
    {
      "start": 141.52,
      "end": 143.68,
      "text": "你会重新和他们站到同一战线的"
    },
    {
      "start": 143.68,
      "end": 144.68,
      "text": "被离婚的你"
    },
    {
      "start": 144.68,
      "end": 146.4,
      "text": "是不是觉得对方很自私"
    },
    {
      "start": 146.4,
      "end": 147.56,
      "text": "凭什么婚姻要维持"
    },
    {
      "start": 147.56,
      "end": 148.96,
      "text": "就全都得遂你意"
    },
    {
      "start": 148.96,
      "end": 150.0,
      "text": "因为对方呢"
    },
    {
      "start": 150.0,
      "end": 150.92,
      "text": "不好意思"
    },
    {
      "start": 150.92,
      "end": 152.28,
      "text": "对方就是已经醒悟自己"
    },
    {
      "start": 152.28,
      "end": 153.76,
      "text": "做不到与你融合"
    },
    {
      "start": 153.76,
      "end": 154.52,
      "text": "没办法了"
    },
    {
      "start": 154.52,
      "end": 155.68,
      "text": "才选择离婚的"
    },
    {
      "start": 155.68,
      "end": 157.16,
      "text": "你不用高看自己"
    },
    {
      "start": 157.16,
      "end": 159.2,
      "text": "对方和你的心路历程是一样的"
    },
    {
      "start": 159.2,
      "end": 161.08,
      "text": "只不过你还停留在恐惧离婚"
    },
    {
      "start": 161.08,
      "end": 162.12,
      "text": "未知的阶段"
    },
    {
      "start": 162.12,
      "end": 164.0,
      "text": "而对方已经过了这个阶段"
    },
    {
      "start": 164.0,
      "end": 165.16,
      "text": "所以背离的你"
    },
    {
      "start": 165.16,
      "end": 167.0,
      "text": "请立刻纠正你的错误思维"
    },
    {
      "start": 167.0,
      "end": 167.72,
      "text": "对方"
    },
    {
      "start": 167.72,
      "end": 168.96,
      "text": "并不是天然就和你形成"
    },
    {
      "start": 168.96,
      "end": 170.52,
      "text": "离与不离的立场对抗"
    },
    {
      "start": 170.52,
      "end": 172.52,
      "text": "应该说对方最底层的立场"
    },
    {
      "start": 172.52,
      "end": 174.4,
      "text": "也是希望婚姻能够存续下去的"
    },
    {
      "start": 174.44,
      "end": 175.2,
      "text": "只不过"
    },
    {
      "start": 175.2,
      "end": 176.76,
      "text": "她要的婚姻存续"
    },
    {
      "start": 176.76,
      "end": 178.64,
      "text": "已经不再是单纯被情绪裹胁的"
    },
    {
      "start": 178.64,
      "end": 179.72,
      "text": "无脑对抗"
    },
    {
      "start": 179.72,
      "end": 181.16,
      "text": "而是婚姻要存续"
    },
    {
      "start": 181.16,
      "end": 183.64,
      "text": "自己就必须能幸福的现实现状"
    },
    {
      "start": 183.64,
      "end": 185.4,
      "text": "你内心的挽回心境"
    },
    {
      "start": 185.4,
      "end": 187.2,
      "text": "动摇不了对方离婚的决心"
    },
    {
      "start": 187.2,
      "end": 188.8,
      "text": "真不是对方铁石心肠"
    },
    {
      "start": 188.8,
      "end": 189.96,
      "text": "狠心绝情"
    },
    {
      "start": 189.96,
      "end": 192.36,
      "text": "而是对方在其现有认知范围内"
    },
    {
      "start": 192.36,
      "end": 193.72,
      "text": "已经通过努力"
    },
    {
      "start": 193.72,
      "end": 194.44,
      "text": "客观"
    },
    {
      "start": 194.44,
      "end": 196.64,
      "text": "确认自己无法做到继续婚姻"
    },
    {
      "start": 196.64,
      "end": 197.96,
      "text": "又能得到幸福"
    },
    {
      "start": 197.96,
      "end": 200.36,
      "text": "本来是寄望你有她意料之外的神技"
    },
    {
      "start": 200.36,
      "end": 201.72,
      "text": "能解决这个难题"
    },
    {
      "start": 201.72,
      "end": 203.36,
      "text": "谁知你所呈现的水平"
    },
    {
      "start": 203.4,
      "end": 205.52,
      "text": "比她自己尝试过的还要低级"
    },
    {
      "start": 205.52,
      "end": 207.44,
      "text": "总结起来就是无能"
    },
    {
      "start": 207.44,
      "end": 208.28,
      "text": "没耐心"
    },
    {
      "start": 208.28,
      "end": 209.48,
      "text": "自私怕离"
    },
    {
      "start": 209.48,
      "end": 211.92,
      "text": "从头到尾都透露着一种无赖起息"
    },
    {
      "start": 211.92,
      "end": 213.48,
      "text": "妄想仅靠言语"
    },
    {
      "start": 213.48,
      "end": 214.72,
      "text": "靠时而疯狂"
    },
    {
      "start": 214.72,
      "end": 216.2,
      "text": "时而悲惨的演绎"
    },
    {
      "start": 216.2,
      "end": 217.76,
      "text": "只要对方故作委屈"
    },
    {
      "start": 217.76,
      "end": 219.28,
      "text": "自己先放弃离婚"
    },
    {
      "start": 219.28,
      "end": 220.48,
      "text": "而得到的结果"
    },
    {
      "start": 220.48,
      "end": 223.24,
      "text": "又仅仅只是让你不用再被坏情绪折磨"
    },
    {
      "start": 223.24,
      "end": 224.84,
      "text": "所以真想留住对方"
    },
    {
      "start": 224.84,
      "end": 227.0,
      "text": "就止住那个空虚内耗的自己"
    },
    {
      "start": 227.0,
      "end": 227.92,
      "text": "不要再拿着空气"
    },
    {
      "start": 227.92,
      "end": 229.76,
      "text": "去和对方发生各种联系"
    },
    {
      "start": 229.76,
      "end": 230.8,
      "text": "行动起来"
    },
    {
      "start": 230.8,
      "end": 232.24,
      "text": "该换工作换工作"
    },
    {
      "start": 232.24,
      "end": 233.48,
      "text": "该搬家搬家"
    },
    {
      "start": 233.48,
      "end": 234.88,
      "text": "尽自己的极限去"
    },
    {
      "start": 234.88,
      "end": 236.44,
      "text": "让影响婚姻的人事物"
    },
    {
      "start": 236.44,
      "end": 238.24,
      "text": "都真真切切地发生改变"
    },
    {
      "start": 238.24,
      "end": 240.2,
      "text": "不要给修复婚姻设定时间"
    },
    {
      "start": 240.2,
      "end": 242.44,
      "text": "也不要去干涉对方的思想行动"
    },
    {
      "start": 242.44,
      "end": 244.2,
      "text": "就算对方在暗处观察"
    },
    {
      "start": 244.2,
      "end": 245.48,
      "text": "也没什么好担心的"
    },
    {
      "start": 245.48,
      "end": 246.8,
      "text": "当你在用事实改变"
    },
    {
      "start": 246.8,
      "end": 247.88,
      "text": "时间渐远"
    },
    {
      "start": 247.88,
      "end": 249.16,
      "text": "你就一定会成长"
    },
    {
      "start": 249.16,
      "end": 251.28,
      "text": "只要走在正确修复婚姻的路上"
    },
    {
      "start": 251.28,
      "end": 252.36,
      "text": "最终的结局"
    },
    {
      "start": 252.36,
      "end": 253.44,
      "text": "就一定不差"
    },
    {
      "start": 253.44,
      "end": 254.92,
      "text": "通常是对方和你的"
    },
    {
      "start": 254.92,
      "end": 255.76,
      "text": "夫妻关系"
    },
    {
      "start": 255.76,
      "end": 256.72,
      "text": "会比婚姻危机前"
    },
    {
      "start": 256.72,
      "end": 258.16,
      "text": "更健康更亲密"
    },
    {
      "start": 258.16,
      "end": 259.52,
      "text": "如果不是这个结局"
    },
    {
      "start": 259.52,
      "end": 261.52,
      "text": "也绝不会是你被抛弃的悲剧"
    },
    {
      "start": 261.52,
      "end": 262.68,
      "text": "而是你会很安心"
    },
    {
      "start": 262.68,
      "end": 263.64,
      "text": "很安宁"
    },
    {
      "start": 263.64,
      "end": 265.52,
      "text": "对方配不上成长后的你"
    },
    {
      "start": 265.52,
      "end": 266.64,
      "text": "今天就到这里"
    },
    {
      "start": 266.64,
      "end": 267.52,
      "text": "我是李安"
    },
    {
      "start": 267.52,
      "end": 268.72,
      "text": "麻烦动动小手"
    },
    {
      "start": 268.72,
      "end": 269.32,
      "text": "支持一下"
    }
  ]
}