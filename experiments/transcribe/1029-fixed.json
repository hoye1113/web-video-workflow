{
  "file": "E:\\彬\\1029.mp4",
  "language": "zh",
  "duration": 368.38,
  "segments": [
    {
      "start": 0.0,
      "end": 2.64,
      "text": "你喜欢的那个女生 其实也在偷偷喜欢你"
    },
    {
      "start": 2.64,
      "end": 5.52,
      "text": "我有预感 今天只要你敢留下一句在一起"
    },
    {
      "start": 5.52,
      "end": 7.68,
      "text": "并且认真听 老老实实照做"
    },
    {
      "start": 7.68,
      "end": 10.44,
      "text": "对方很快就会主动来找你确认心意"
    },
    {
      "start": 10.44,
      "end": 13.84,
      "text": "今天给兄弟们分享女生最喜欢的三种追求方式"
    },
    {
      "start": 13.84,
      "end": 16.16,
      "text": "记得点赞收藏 反复观看"
    },
    {
      "start": 16.16,
      "end": 17.36,
      "text": "先问大家一个问题"
    },
    {
      "start": 17.36,
      "end": 19.64,
      "text": "你是怎么追求你喜欢的女生的"
    },
    {
      "start": 19.64,
      "end": 22.04,
      "text": "天天嘘寒问暖 买礼物制造惊喜"
    },
    {
      "start": 22.04,
      "end": 24.04,
      "text": "还是故作高冷 欲擒故纵"
    },
    {
      "start": 24.04,
      "end": 25.88,
      "text": "用这样的方式可以追到她吗"
    },
    {
      "start": 25.88,
      "end": 26.84,
      "text": "只能说很难"
    },
    {
      "start": 26.84,
      "end": 28.84,
      "text": "那是不是这两种方式都错了呢"
    },
    {
      "start": 28.84,
      "end": 29.68,
      "text": "倒也不是"
    },
    {
      "start": 29.68,
      "end": 32.92,
      "text": "单从方式来讲 哪种方式都没有绝对的对和错"
    },
    {
      "start": 32.92,
      "end": 35.84,
      "text": "但是难度等级和收益效果是有差别的"
    },
    {
      "start": 35.84,
      "end": 38.56,
      "text": "很多兄弟就觉得追不到女生是自己的问题"
    },
    {
      "start": 38.56,
      "end": 40.4,
      "text": "是不是我太丑了 太穷了"
    },
    {
      "start": 40.4,
      "end": 40.96,
      "text": "不是"
    },
    {
      "start": 40.96,
      "end": 43.4,
      "text": "很多时候不是你自身条件有多差"
    },
    {
      "start": 43.4,
      "end": 45.56,
      "text": "而是你的追求方式存在问题"
    },
    {
      "start": 45.56,
      "end": 48.76,
      "text": "今天我就来分析三种女生最喜欢的追求方式"
    },
    {
      "start": 48.76,
      "end": 50.68,
      "text": "大家可以收藏起来反复观看"
    },
    {
      "start": 50.68,
      "end": 52.28,
      "text": "第一种 无压力的追求"
    },
    {
      "start": 52.28,
      "end": 55.2,
      "text": "简单来说 就是不要让女生觉得你在追她"
    },
    {
      "start": 55.2,
      "end": 57.2,
      "text": "很多男生在追女生的过程中"
    },
    {
      "start": 57.24,
      "end": 58.48,
      "text": "不断的跟女生示好"
    },
    {
      "start": 58.48,
      "end": 61.12,
      "text": "送礼物 买鲜花 送外卖 发红包"
    },
    {
      "start": 61.12,
      "end": 62.84,
      "text": "甚至上下班也准时接送"
    },
    {
      "start": 62.84,
      "end": 64.16,
      "text": "成为她的代驾司机"
    },
    {
      "start": 64.16,
      "end": 65.76,
      "text": "这样的方式浪费时间"
    },
    {
      "start": 65.76,
      "end": 67.64,
      "text": "浪费精力 浪费金钱不说"
    },
    {
      "start": 67.64,
      "end": 70.92,
      "text": "关键是会让女生觉得自己好像站在悬崖边上一样"
    },
    {
      "start": 70.92,
      "end": 72.08,
      "text": "要么和你在一起"
    },
    {
      "start": 72.08,
      "end": 73.64,
      "text": "要么她就得跳下去"
    },
    {
      "start": 73.64,
      "end": 75.68,
      "text": "这种极具压迫感的追求方式"
    },
    {
      "start": 75.68,
      "end": 77.44,
      "text": "会让女生觉得很不舒服"
    },
    {
      "start": 77.44,
      "end": 79.28,
      "text": "那这个不舒服是谁给的呢"
    },
    {
      "start": 79.28,
      "end": 80.2,
      "text": "是你给的"
    },
    {
      "start": 80.2,
      "end": 83.12,
      "text": "所以如果你只会通过这样的示好去追求"
    },
    {
      "start": 83.12,
      "end": 85.0,
      "text": "女生有很大的概率会输得很远"
    },
    {
      "start": 85.0,
      "end": 86.24,
      "text": "那有的人又会说了"
    },
    {
      "start": 86.24,
      "end": 87.08,
      "text": "你说的不对"
    },
    {
      "start": 87.08,
      "end": 88.72,
      "text": "我用这种方式追到过呀"
    },
    {
      "start": 88.72,
      "end": 89.76,
      "text": "其实这种情况"
    },
    {
      "start": 89.76,
      "end": 91.88,
      "text": "有可能是有一部分女生很单纯"
    },
    {
      "start": 91.88,
      "end": 93.36,
      "text": "她们很容易被男生这种"
    },
    {
      "start": 93.36,
      "end": 95.04,
      "text": "锲而不舍的精神所打动"
    },
    {
      "start": 95.04,
      "end": 96.4,
      "text": "但是一旦恋爱开始"
    },
    {
      "start": 96.4,
      "end": 98.48,
      "text": "你只要有那么一丁点的小事没做好"
    },
    {
      "start": 98.48,
      "end": 99.32,
      "text": "女生就会觉得"
    },
    {
      "start": 99.32,
      "end": 101.2,
      "text": "你根本就不是真心对我好"
    },
    {
      "start": 101.2,
      "end": 103.2,
      "text": "你对我好不就是为了得到我吗"
    },
    {
      "start": 103.2,
      "end": 105.16,
      "text": "得到了之后你就不会珍惜了"
    },
    {
      "start": 105.16,
      "end": 106.32,
      "text": "这种靠你的坚持"
    },
    {
      "start": 106.32,
      "end": 107.24,
      "text": "用鲜花礼物"
    },
    {
      "start": 107.24,
      "end": 109.2,
      "text": "无微不至的照顾追回来的女生"
    },
    {
      "start": 109.2,
      "end": 109.92,
      "text": "在一起之后"
    },
    {
      "start": 109.92,
      "end": 112.04,
      "text": "她会觉得追求的时候你能做到"
    },
    {
      "start": 112.04,
      "end": 114.0,
      "text": "恋爱的时候你更应该做得更好"
    },
    {
      "start": 114.0,
      "end": 115.2,
      "text": "虽然她不是渣女"
    },
    {
      "start": 115.2,
      "end": 116.56,
      "text": "也不是图你这些东西"
    },
    {
      "start": 116.56,
      "end": 117.76,
      "text": "但是在她的观念里"
    },
    {
      "start": 117.76,
      "end": 119.92,
      "text": "这些才是能证明你爱她的东西"
    },
    {
      "start": 119.92,
      "end": 121.64,
      "text": "所以她会不停的要求你"
    },
    {
      "start": 121.64,
      "end": 123.76,
      "text": "让你从一而终甚至做得更多"
    },
    {
      "start": 123.76,
      "end": 125.4,
      "text": "在这种恋爱状态之下的男生"
    },
    {
      "start": 125.4,
      "end": 127.12,
      "text": "会变得越来越小心翼翼"
    },
    {
      "start": 127.12,
      "end": 128.76,
      "text": "最后要么她觉得你变了"
    },
    {
      "start": 128.76,
      "end": 129.4,
      "text": "抛弃你"
    },
    {
      "start": 129.4,
      "end": 131.48,
      "text": "要么就会觉得维系关系太累了"
    },
    {
      "start": 131.48,
      "end": 132.32,
      "text": "无奈放手"
    },
    {
      "start": 132.32,
      "end": 133.64,
      "text": "所以追女生的时候"
    },
    {
      "start": 133.64,
      "end": 135.08,
      "text": "大家请记住八个字"
    },
    {
      "start": 135.08,
      "end": 136.64,
      "text": "无欲则刚 心态为王"
    },
    {
      "start": 136.64,
      "end": 138.52,
      "text": "永远不要让女生觉得你在追她"
    },
    {
      "start": 138.52,
      "end": 140.4,
      "text": "我知道你一定会不断的联系她"
    },
    {
      "start": 140.4,
      "end": 141.28,
      "text": "给她发消息"
    },
    {
      "start": 141.28,
      "end": 142.64,
      "text": "就是很想和她在一起"
    },
    {
      "start": 142.64,
      "end": 144.12,
      "text": "但是大家换位思考一下"
    },
    {
      "start": 144.12,
      "end": 145.28,
      "text": "如果你是一个女生"
    },
    {
      "start": 145.28,
      "end": 146.64,
      "text": "有一天有一个男生"
    },
    {
      "start": 146.64,
      "end": 148.16,
      "text": "突然很特别的跟你说"
    },
    {
      "start": 148.16,
      "end": 148.92,
      "text": "我要追你"
    },
    {
      "start": 148.92,
      "end": 150.12,
      "text": "我要跟你在一块"
    },
    {
      "start": 150.12,
      "end": 151.16,
      "text": "你是不是会觉得"
    },
    {
      "start": 151.16,
      "end": 152.32,
      "text": "他这是见色起意"
    },
    {
      "start": 152.32,
      "end": 154.2,
      "text": "你在她眼中就像是一个物品"
    },
    {
      "start": 154.2,
      "end": 154.96,
      "text": "那这个时候"
    },
    {
      "start": 154.96,
      "end": 156.48,
      "text": "你还会愿意跟她在一块吗"
    },
    {
      "start": 156.48,
      "end": 157.64,
      "text": "所以说前期的交流"
    },
    {
      "start": 157.64,
      "end": 159.88,
      "text": "我们一定要以留下良好的印象为主"
    },
    {
      "start": 159.88,
      "end": 161.16,
      "text": "两个人认识的初期"
    },
    {
      "start": 161.16,
      "end": 163.04,
      "text": "你只需要和女生简单的聊天"
    },
    {
      "start": 163.04,
      "end": 163.88,
      "text": "相互了解"
    },
    {
      "start": 163.88,
      "end": 165.32,
      "text": "然后丰富你的朋友圈"
    },
    {
      "start": 165.32,
      "end": 168.08,
      "text": "让她看到你充实快乐的生活就足够了"
    },
    {
      "start": 168.08,
      "end": 169.8,
      "text": "让她觉得你的生活有意思"
    },
    {
      "start": 169.8,
      "end": 170.68,
      "text": "丰富多彩"
    },
    {
      "start": 170.68,
      "end": 172.72,
      "text": "当女生不再排斥和你的沟通"
    },
    {
      "start": 172.72,
      "end": 174.08,
      "text": "把你当成朋友之后"
    },
    {
      "start": 174.08,
      "end": 175.28,
      "text": "我们在自然而然的"
    },
    {
      "start": 175.28,
      "end": 177.44,
      "text": "以朋友的身份约她出去吃饭"
    },
    {
      "start": 177.44,
      "end": 178.76,
      "text": "散散步 说说话"
    },
    {
      "start": 178.76,
      "end": 180.44,
      "text": "适当进行一些肢体接触"
    },
    {
      "start": 180.44,
      "end": 181.4,
      "text": "接下来在这样"
    },
    {
      "start": 181.4,
      "end": 183.0,
      "text": "暧昧相处一段时间之后"
    },
    {
      "start": 183.0,
      "end": 184.32,
      "text": "你能感受到这个女生"
    },
    {
      "start": 184.32,
      "end": 185.8,
      "text": "对你好感度很高的时候"
    },
    {
      "start": 185.8,
      "end": 187.56,
      "text": "再去进行一个正式的表白"
    },
    {
      "start": 187.56,
      "end": 188.52,
      "text": "这个流程才是"
    },
    {
      "start": 188.52,
      "end": 190.92,
      "text": "绝大多数女生都喜欢的追求方式"
    },
    {
      "start": 190.92,
      "end": 192.76,
      "text": "第二种 占据主导权的追求"
    },
    {
      "start": 192.76,
      "end": 194.68,
      "text": "大多数女生都有慕强的心理"
    },
    {
      "start": 194.68,
      "end": 196.32,
      "text": "如果你表现得比女生还弱"
    },
    {
      "start": 196.32,
      "end": 198.32,
      "text": "天天就知道打游戏 刷短视频"
    },
    {
      "start": 198.32,
      "end": 200.76,
      "text": "没有自己的事业和充实的业余生活"
    },
    {
      "start": 200.76,
      "end": 202.32,
      "text": "遇到事情又没有主见"
    },
    {
      "start": 202.32,
      "end": 203.08,
      "text": "犹豫不决"
    },
    {
      "start": 203.08,
      "end": 203.88,
      "text": "在女生面前"
    },
    {
      "start": 203.88,
      "end": 205.92,
      "text": "天天就知道抱怨这个抱怨那个"
    },
    {
      "start": 205.92,
      "end": 208.44,
      "text": "那女生会对这种幼稚的男生心动吗"
    },
    {
      "start": 208.44,
      "end": 209.36,
      "text": "你要是个女生"
    },
    {
      "start": 209.36,
      "end": 211.48,
      "text": "你都不会跟这样的男生谈恋爱吧"
    },
    {
      "start": 211.48,
      "end": 213.0,
      "text": "今天找你安慰安慰"
    },
    {
      "start": 213.0,
      "end": 214.84,
      "text": "明天让你帮她拿个主意"
    },
    {
      "start": 214.84,
      "end": 216.12,
      "text": "又当爹又当妈"
    },
    {
      "start": 216.12,
      "end": 217.56,
      "text": "谁疯了喜欢这样的"
    },
    {
      "start": 217.56,
      "end": 218.44,
      "text": "所以这个时候"
    },
    {
      "start": 218.44,
      "end": 220.56,
      "text": "我们就得表现出自己强势的一面"
    },
    {
      "start": 220.56,
      "end": 222.36,
      "text": "一定要学会去带领女生"
    },
    {
      "start": 222.36,
      "end": 224.4,
      "text": "注意我说的这个词是带领"
    },
    {
      "start": 224.4,
      "end": 225.88,
      "text": "比如说出来约会的时候"
    },
    {
      "start": 225.88,
      "end": 226.64,
      "text": "不要老是问她"
    },
    {
      "start": 226.64,
      "end": 228.16,
      "text": "你想去哪喜欢吃什么"
    },
    {
      "start": 228.16,
      "end": 229.28,
      "text": "你就应该对她说"
    },
    {
      "start": 229.28,
      "end": 230.72,
      "text": "我知道有个地方很不错"
    },
    {
      "start": 230.72,
      "end": 232.56,
      "text": "我带你去 保证你会喜欢"
    },
    {
      "start": 232.6,
      "end": 234.36,
      "text": "上次吃过一家店很不错"
    },
    {
      "start": 234.36,
      "end": 235.48,
      "text": "我带你去尝尝"
    },
    {
      "start": 235.48,
      "end": 237.16,
      "text": "这个时候有些人反驳了"
    },
    {
      "start": 237.16,
      "end": 237.8,
      "text": "瞎说"
    },
    {
      "start": 237.8,
      "end": 239.72,
      "text": "这明明是叫尊重女生的意见"
    },
    {
      "start": 239.72,
      "end": 241.68,
      "text": "尊重女生这个想法肯定好"
    },
    {
      "start": 241.68,
      "end": 243.0,
      "text": "但你要是过于尊重"
    },
    {
      "start": 243.0,
      "end": 243.84,
      "text": "在女生看来"
    },
    {
      "start": 243.84,
      "end": 244.92,
      "text": "你就是没有底线"
    },
    {
      "start": 244.92,
      "end": 245.96,
      "text": "没有主见的"
    },
    {
      "start": 245.96,
      "end": 247.4,
      "text": "这只会让你在女生面前"
    },
    {
      "start": 247.4,
      "end": 248.24,
      "text": "越来越被动"
    },
    {
      "start": 248.24,
      "end": 249.96,
      "text": "其实占据主导权也很简单"
    },
    {
      "start": 249.96,
      "end": 251.04,
      "text": "大家记住一句话"
    },
    {
      "start": 251.04,
      "end": 253.04,
      "text": "不要让你自己觉得你在追她"
    },
    {
      "start": 253.04,
      "end": 254.56,
      "text": "当你有了这样的想法之后"
    },
    {
      "start": 254.56,
      "end": 256.2,
      "text": "心态直接就低她一等"
    },
    {
      "start": 256.2,
      "end": 258.12,
      "text": "你会开始变得患得患失"
    },
    {
      "start": 258.12,
      "end": 259.64,
      "text": "你会想着去讨好她"
    },
    {
      "start": 259.64,
      "end": 260.56,
      "text": "想让她开心"
    },
    {
      "start": 260.56,
      "end": 261.96,
      "text": "但是在这个过程当中"
    },
    {
      "start": 262.0,
      "end": 263.68,
      "text": "你就忽略了自己的感受"
    },
    {
      "start": 263.68,
      "end": 264.84,
      "text": "在不知不觉当中"
    },
    {
      "start": 264.84,
      "end": 266.12,
      "text": "就变得很卑微"
    },
    {
      "start": 266.12,
      "end": 267.72,
      "text": "你小心翼翼的说话做事"
    },
    {
      "start": 267.72,
      "end": 269.16,
      "text": "生怕她不开心"
    },
    {
      "start": 269.16,
      "end": 270.08,
      "text": "她就不理你了"
    },
    {
      "start": 270.08,
      "end": 271.8,
      "text": "一点作为男人的样子都没有"
    },
    {
      "start": 271.8,
      "end": 272.72,
      "text": "大家请注意"
    },
    {
      "start": 272.72,
      "end": 274.64,
      "text": "人只会对于自己价值相当"
    },
    {
      "start": 274.64,
      "end": 276.24,
      "text": "或者高于自身价值的人"
    },
    {
      "start": 276.24,
      "end": 277.48,
      "text": "产生暧昧的心理"
    },
    {
      "start": 277.48,
      "end": 278.92,
      "text": "你再看看你这些行为"
    },
    {
      "start": 278.92,
      "end": 280.44,
      "text": "你像高价值的人吗"
    },
    {
      "start": 280.44,
      "end": 280.92,
      "text": "所以"
    },
    {
      "start": 280.92,
      "end": 282.44,
      "text": "如果你想追求一个女生"
    },
    {
      "start": 282.44,
      "end": 284.2,
      "text": "首先不是你要对她有多好"
    },
    {
      "start": 284.2,
      "end": 285.84,
      "text": "而是去展示自身的价值"
    },
    {
      "start": 285.84,
      "end": 287.12,
      "text": "和你作为男性的魅力"
    },
    {
      "start": 287.12,
      "end": 288.68,
      "text": "去占据一个主导权"
    },
    {
      "start": 288.68,
      "end": 290.04,
      "text": "女生不是靠追来的"
    },
    {
      "start": 290.04,
      "end": 291.32,
      "text": "而是靠吸引来的"
    },
    {
      "start": 291.36,
      "end": 292.2,
      "text": "她不强大"
    },
    {
      "start": 292.2,
      "end": 293.08,
      "text": "而你很强"
    },
    {
      "start": 293.08,
      "end": 294.96,
      "text": "这才是吸引力法则的核心"
    },
    {
      "start": 294.96,
      "end": 296.96,
      "text": "我们就要去提升自己的吸引力"
    },
    {
      "start": 296.96,
      "end": 298.44,
      "text": "去给女生提供价值"
    },
    {
      "start": 298.44,
      "end": 299.84,
      "text": "而情绪价值高的人"
    },
    {
      "start": 299.84,
      "end": 301.96,
      "text": "总能让别人在和她相处的过程中"
    },
    {
      "start": 301.96,
      "end": 302.96,
      "text": "感觉到舒服"
    },
    {
      "start": 302.96,
      "end": 303.76,
      "text": "升级关系"
    },
    {
      "start": 303.76,
      "end": 305.16,
      "text": "自然也是水到渠成"
    },
    {
      "start": 305.16,
      "end": 305.76,
      "text": "第三种"
    },
    {
      "start": 305.76,
      "end": 307.36,
      "text": "让她为你付出的追求"
    },
    {
      "start": 307.36,
      "end": 309.2,
      "text": "很多男生在追女生的时候"
    },
    {
      "start": 309.2,
      "end": 311.52,
      "text": "习惯性的把所有事情都自己扛"
    },
    {
      "start": 311.52,
      "end": 312.84,
      "text": "所有付出都自己来"
    },
    {
      "start": 312.84,
      "end": 314.2,
      "text": "请客吃饭你买单"
    },
    {
      "start": 314.2,
      "end": 315.52,
      "text": "安排约会你全包"
    },
    {
      "start": 315.52,
      "end": 317.4,
      "text": "连她随口提句想喝奶茶"
    },
    {
      "start": 317.4,
      "end": 319.36,
      "text": "你都立刻点好送到她楼下"
    },
    {
      "start": 319.36,
      "end": 320.6,
      "text": "你以为这样是体贴"
    },
    {
      "start": 320.6,
      "end": 322.32,
      "text": "其实你是在把她养成一个"
    },
    {
      "start": 322.32,
      "end": 324.2,
      "text": "只会接受不会付出的人"
    },
    {
      "start": 324.2,
      "end": 325.72,
      "text": "人对一段关系的投入"
    },
    {
      "start": 325.72,
      "end": 327.52,
      "text": "不只看对方对自己有多好"
    },
    {
      "start": 327.52,
      "end": 329.48,
      "text": "也看自己为对方付出了多少"
    },
    {
      "start": 329.48,
      "end": 331.6,
      "text": "心理学上有个词叫沉没成本"
    },
    {
      "start": 331.6,
      "end": 333.72,
      "text": "一个人在一段关系里投入的越多"
    },
    {
      "start": 333.72,
      "end": 334.76,
      "text": "就越难抽身"
    },
    {
      "start": 334.76,
      "end": 336.32,
      "text": "所以你不仅要对她好"
    },
    {
      "start": 336.32,
      "end": 338.28,
      "text": "还要学会引导她为你付出"
    },
    {
      "start": 338.28,
      "end": 340.04,
      "text": "比如让她帮你挑一件衣服"
    },
    {
      "start": 340.04,
      "end": 341.52,
      "text": "让她给你推荐一本书"
    },
    {
      "start": 341.52,
      "end": 342.8,
      "text": "让她帮你出个主意"
    },
    {
      "start": 342.8,
      "end": 343.88,
      "text": "这些小小的付出"
    },
    {
      "start": 343.88,
      "end": 346.2,
      "text": "会让她在心里慢慢把你当成自己人"
    },
    {
      "start": 346.2,
      "end": 347.28,
      "text": "她为你花的时间"
    },
    {
      "start": 347.28,
      "end": 348.6,
      "text": "心思和精力越多"
    },
    {
      "start": 348.6,
      "end": 349.72,
      "text": "她就越在意你"
    },
    {
      "start": 349.72,
      "end": 350.72,
      "text": "这不是算计"
    },
    {
      "start": 350.72,
      "end": 353.12,
      "text": "这是让关系走向平衡的必经之路"
    },
    {
      "start": 353.12,
      "end": 355.04,
      "text": "如果你现在正在追一个女生"
    },
    {
      "start": 355.04,
      "end": 356.24,
      "text": "感觉你们聊得还行"
    },
    {
      "start": 356.24,
      "end": 357.8,
      "text": "但关系总停在原地"
    },
    {
      "start": 357.8,
      "end": 358.96,
      "text": "可以自己复盘一下"
    },
    {
      "start": 358.96,
      "end": 360.48,
      "text": "到底是节奏出了问题"
    },
    {
      "start": 360.48,
      "end": 362.08,
      "text": "还是话题一直没落在"
    },
    {
      "start": 362.08,
      "end": 363.48,
      "text": "她真正在意的地方"
    },
    {
      "start": 363.48,
      "end": 364.84,
      "text": "追女生不是靠套路"
    },
    {
      "start": 364.84,
      "end": 365.6,
      "text": "而是靠你"
    },
    {
      "start": 365.6,
      "end": 366.84,
      "text": "让她在每一次对话里"
    },
    {
      "start": 366.84,
      "end": 368.36,
      "text": "都愿意再多了解你一点"
    }
  ]
}