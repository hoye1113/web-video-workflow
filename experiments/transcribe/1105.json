{
  "file": "E:\\彬\\1105.mp4",
  "language": "zh",
  "duration": 383.18,
  "segments": [
    {
      "start": 0.0,
      "end": 1.36,
      "text": "夫妻俩想重归于好"
    },
    {
      "start": 1.36,
      "end": 3.08,
      "text": "就一定要脱离追蛇效应"
    },
    {
      "start": 3.08,
      "end": 4.2,
      "text": "今天要讲的是"
    },
    {
      "start": 4.2,
      "end": 6.68,
      "text": "婚姻里一个容易被忽略的心理陷阱"
    },
    {
      "start": 6.68,
      "end": 7.52,
      "text": "为什么"
    },
    {
      "start": 7.52,
      "end": 9.92,
      "text": "有些夫妻刚结婚时明明很亲密"
    },
    {
      "start": 9.92,
      "end": 11.6,
      "text": "遇到矛盾也愿意沟通"
    },
    {
      "start": 11.6,
      "end": 13.72,
      "text": "可时间一长却越来越累"
    },
    {
      "start": 13.72,
      "end": 14.96,
      "text": "话越来越少"
    },
    {
      "start": 14.96,
      "end": 16.12,
      "text": "关系越来越僵"
    },
    {
      "start": 16.12,
      "end": 17.92,
      "text": "明明心里还在乎对方"
    },
    {
      "start": 17.92,
      "end": 20.0,
      "text": "却总是一个追着解释"
    },
    {
      "start": 20.0,
      "end": 21.12,
      "text": "一个躲着不说"
    },
    {
      "start": 21.12,
      "end": 22.88,
      "text": "最后两个人都觉得委屈"
    },
    {
      "start": 22.88,
      "end": 24.72,
      "text": "其实很可能是因为"
    },
    {
      "start": 24.72,
      "end": 27.2,
      "text": "你们不知不觉陷入了追蛇效应"
    },
    {
      "start": 27.2,
      "end": 28.28,
      "text": "你放不下这个家"
    },
    {
      "start": 28.28,
      "end": 29.36,
      "text": "其实对方也放不下"
    },
    {
      "start": 29.36,
      "end": 31.56,
      "text": "如果你真心实意的留一句和好"
    },
    {
      "start": 31.56,
      "end": 32.76,
      "text": "那这一份心意"
    },
    {
      "start": 32.76,
      "end": 35.0,
      "text": "会悄悄地传到伴侣心里面"
    },
    {
      "start": 35.0,
      "end": 36.48,
      "text": "什么是追蛇效应"
    },
    {
      "start": 36.48,
      "end": 37.28,
      "text": "听我讲个小故事"
    },
    {
      "start": 37.28,
      "end": 37.64,
      "text": "大舍"
    },
    {
      "start": 37.64,
      "end": 38.92,
      "text": "你正在野外走路"
    },
    {
      "start": 38.92,
      "end": 39.88,
      "text": "突然一条毒蛇"
    },
    {
      "start": 39.88,
      "end": 40.96,
      "text": "从草叢里穿出来"
    },
    {
      "start": 40.96,
      "end": 42.48,
      "text": "狠狠咬了你一口"
    },
    {
      "start": 42.48,
      "end": 43.68,
      "text": "这时候最重要的是什么"
    },
    {
      "start": 43.68,
      "end": 45.24,
      "text": "是赶紧处理伤口"
    },
    {
      "start": 45.24,
      "end": 46.48,
      "text": "阻止毒液扩散"
    },
    {
      "start": 46.48,
      "end": 47.64,
      "text": "在及时呼救"
    },
    {
      "start": 47.64,
      "end": 49.76,
      "text": "而不是举着棍子追着蛇跑"
    },
    {
      "start": 49.76,
      "end": 51.36,
      "text": "非要把它打死才解气"
    },
    {
      "start": 51.36,
      "end": 52.48,
      "text": "你一边追"
    },
    {
      "start": 52.48,
      "end": 54.04,
      "text": "一边让毒液扩散"
    },
    {
      "start": 54.04,
      "end": 55.56,
      "text": "最后可能蛇还没追到"
    },
    {
      "start": 55.56,
      "end": 56.68,
      "text": "自己先倒下了"
    },
    {
      "start": 56.68,
      "end": 57.76,
      "text": "放到婚姻里"
    },
    {
      "start": 57.76,
      "end": 58.6,
      "text": "是不是也很像"
    },
    {
      "start": 58.6,
      "end": 60.2,
      "text": "伴侣突然不愿意说话"
    },
    {
      "start": 60.2,
      "end": 61.76,
      "text": "回家只顾着看手机"
    },
    {
      "start": 61.76,
      "end": 63.6,
      "text": "或者对你的关心回应冷淡"
    },
    {
      "start": 63.6,
      "end": 64.6,
      "text": "你马上追问"
    },
    {
      "start": 64.6,
      "end": 65.4,
      "text": "你到底怎么了"
    },
    {
      "start": 65.4,
      "end": 66.88,
      "text": "你是不是对这个家没感情了"
    },
    {
      "start": 66.88,
      "end": 67.88,
      "text": "你为什么不能好好说话"
    },
    {
      "start": 67.88,
      "end": 69.36,
      "text": "对方本来就烦躁"
    },
    {
      "start": 69.36,
      "end": 70.24,
      "text": "听见追问"
    },
    {
      "start": 70.24,
      "end": 71.28,
      "text": "更想躲"
    },
    {
      "start": 71.28,
      "end": 72.4,
      "text": "你看见对方躲"
    },
    {
      "start": 72.4,
      "end": 73.96,
      "text": "又觉得自己被冷落"
    },
    {
      "start": 73.96,
      "end": 75.4,
      "text": "于是越问越急"
    },
    {
      "start": 75.4,
      "end": 76.96,
      "text": "越急越想要一个态度"
    },
    {
      "start": 76.96,
      "end": 78.68,
      "text": "甚至前一场争厂还没过去"
    },
    {
      "start": 78.68,
      "end": 80.84,
      "text": "你已经翻出以前所有的就诈"
    },
    {
      "start": 80.84,
      "end": 83.2,
      "text": "非要今天把每个问题都说清楚"
    },
    {
      "start": 83.2,
      "end": 84.92,
      "text": "你以为自己是在挽救婚姻"
    },
    {
      "start": 84.92,
      "end": 86.6,
      "text": "其实可能正在追蛇"
    },
    {
      "start": 86.6,
      "end": 87.96,
      "text": "你越追自己越受伤"
    },
    {
      "start": 87.96,
      "end": 88.96,
      "text": "对方也越防备"
    },
    {
      "start": 88.96,
      "end": 90.68,
      "text": "一个觉得怎么做都不对"
    },
    {
      "start": 90.68,
      "end": 91.96,
      "text": "一个觉得自己的感受"
    },
    {
      "start": 91.96,
      "end": 92.96,
      "text": "始终没人听见"
    },
    {
      "start": 92.96,
      "end": 93.76,
      "text": "时间久了"
    },
    {
      "start": 93.76,
      "end": 95.0,
      "text": "沟通变成审问"
    },
    {
      "start": 95.0,
      "end": 96.36,
      "text": "沉默变成惩罚"
    },
    {
      "start": 96.36,
      "end": 97.8,
      "text": "原本想靠近的两个人"
    },
    {
      "start": 97.8,
      "end": 98.68,
      "text": "反而越走越远"
    },
    {
      "start": 98.68,
      "end": 100.6,
      "text": "当然这不是说遇到冷暴力"
    },
    {
      "start": 100.6,
      "end": 102.36,
      "text": "长期忽视就应该忍着"
    },
    {
      "start": 102.36,
      "end": 104.0,
      "text": "也不是说提出问题的人有错"
    },
    {
      "start": 104.0,
      "end": 105.24,
      "text": "问题需要面对"
    },
    {
      "start": 105.24,
      "end": 106.76,
      "text": "伤害也需要被看见"
    },
    {
      "start": 106.76,
      "end": 109.12,
      "text": "只是处理问题的顺序和方式很重要"
    },
    {
      "start": 109.12,
      "end": 110.16,
      "text": "那夫妻俩该怎么办"
    },
    {
      "start": 110.16,
      "end": 111.68,
      "text": "接下来这三个破据点"
    },
    {
      "start": 111.68,
      "end": 114.84,
      "text": "能帮助你们先从追蛇的状态里退出来"
    },
    {
      "start": 114.84,
      "end": 116.12,
      "text": "再慢慢恢复"
    },
    {
      "start": 116.12,
      "end": 117.2,
      "text": "有效沟通"
    },
    {
      "start": 117.2,
      "end": 117.92,
      "text": "第一步"
    },
    {
      "start": 117.92,
      "end": 119.08,
      "text": "情绪上来的时候"
    },
    {
      "start": 119.08,
      "end": 119.84,
      "text": "先别追着"
    },
    {
      "start": 119.84,
      "end": 120.72,
      "text": "对方要答案"
    },
    {
      "start": 120.72,
      "end": 122.36,
      "text": "要先处理自己的伤口"
    },
    {
      "start": 122.36,
      "end": 124.16,
      "text": "说句可能不太好听的实话"
    },
    {
      "start": 124.16,
      "end": 125.28,
      "text": "很多夫妻吵架时"
    },
    {
      "start": 125.28,
      "end": 126.84,
      "text": "看起来是在讨论事情"
    },
    {
      "start": 126.84,
      "end": 128.52,
      "text": "实际上早就被情绪带着走了"
    },
    {
      "start": 128.52,
      "end": 130.16,
      "text": "对方挽回一条消息"
    },
    {
      "start": 130.16,
      "end": 132.6,
      "text": "你感受到的可能不只是等待"
    },
    {
      "start": 132.6,
      "end": 133.72,
      "text": "而是被忽略"
    },
    {
      "start": 133.72,
      "end": 135.08,
      "text": "对方语气重了一点"
    },
    {
      "start": 135.08,
      "end": 137.44,
      "text": "你听见的可能不只是一句气话"
    },
    {
      "start": 137.44,
      "end": 139.32,
      "text": "而是我在这个家里不重要"
    },
    {
      "start": 139.32,
      "end": 140.84,
      "text": "这些感受都是真实的"
    },
    {
      "start": 140.84,
      "end": 142.28,
      "text": "但感受不等于全部事实"
    },
    {
      "start": 142.28,
      "end": 143.2,
      "text": "当恐惧"
    },
    {
      "start": 143.2,
      "end": 143.84,
      "text": "委屈"
    },
    {
      "start": 143.84,
      "end": 144.48,
      "text": "愤怒"
    },
    {
      "start": 144.48,
      "end": 145.44,
      "text": "涌上来"
    },
    {
      "start": 145.48,
      "end": 147.36,
      "text": "人很容易用指责"
    },
    {
      "start": 147.36,
      "end": 147.92,
      "text": "质问"
    },
    {
      "start": 147.92,
      "end": 148.64,
      "text": "翻旧账"
    },
    {
      "start": 148.64,
      "end": 149.6,
      "text": "来保护自己"
    },
    {
      "start": 149.6,
      "end": 151.28,
      "text": "结果却把对方推得更远"
    },
    {
      "start": 151.28,
      "end": 152.28,
      "text": "所以"
    },
    {
      "start": 152.28,
      "end": 153.48,
      "text": "当你又想追着伴侣"
    },
    {
      "start": 153.48,
      "end": 154.52,
      "text": "问个明白时"
    },
    {
      "start": 154.52,
      "end": 156.28,
      "text": "先停一停给自己一点缓冲"
    },
    {
      "start": 156.28,
      "end": 157.52,
      "text": "你可以问问自己"
    },
    {
      "start": 157.52,
      "end": 159.04,
      "text": "我现在最难受的到底是什么"
    },
    {
      "start": 159.04,
      "end": 160.48,
      "text": "自觉得不为尊重"
    },
    {
      "start": 160.48,
      "end": 162.04,
      "text": "是害怕关系变淡"
    },
    {
      "start": 162.04,
      "end": 163.88,
      "text": "还是长期承担太多"
    },
    {
      "start": 163.88,
      "end": 165.32,
      "text": "却没有得到理解"
    },
    {
      "start": 165.32,
      "end": 166.68,
      "text": "把感受写下来"
    },
    {
      "start": 166.68,
      "end": 168.4,
      "text": "分清楚发生了什么"
    },
    {
      "start": 168.4,
      "end": 169.76,
      "text": "我怎么理解这件事"
    },
    {
      "start": 169.76,
      "end": 170.92,
      "text": "我真正需要什么"
    },
    {
      "start": 170.92,
      "end": 171.56,
      "text": "比如"
    },
    {
      "start": 171.56,
      "end": 172.8,
      "text": "不要一开口就说"
    },
    {
      "start": 172.8,
      "end": 174.28,
      "text": "你从来不关心这个家"
    },
    {
      "start": 174.28,
      "end": 175.32,
      "text": "可以试着说"
    },
    {
      "start": 175.32,
      "end": 177.16,
      "text": "这几天我们很少好好说话"
    },
    {
      "start": 177.16,
      "end": 178.12,
      "text": "我有些孤单"
    },
    {
      "start": 178.12,
      "end": 179.52,
      "text": "也希望你能抽点时间"
    },
    {
      "start": 179.52,
      "end": 180.12,
      "text": "和我聊聊"
    },
    {
      "start": 180.12,
      "end": 181.2,
      "text": "这也不是压抑情绪"
    },
    {
      "start": 181.2,
      "end": 183.24,
      "text": "更不是把责任都拦到自己身上"
    },
    {
      "start": 183.24,
      "end": 185.52,
      "text": "而是让表达从攻击变成沟通"
    },
    {
      "start": 185.52,
      "end": 186.72,
      "text": "等情绪平稳一些"
    },
    {
      "start": 186.72,
      "end": 188.04,
      "text": "再讨论具体问题"
    },
    {
      "start": 188.04,
      "end": 189.92,
      "text": "才更有机会听见彼此"
    },
    {
      "start": 189.92,
      "end": 191.96,
      "text": "成熟不是永远不生气"
    },
    {
      "start": 191.96,
      "end": 193.24,
      "text": "而是在生气时"
    },
    {
      "start": 193.24,
      "end": 195.08,
      "text": "也尽量不拿最伤人的话"
    },
    {
      "start": 195.08,
      "end": 196.12,
      "text": "惩罚对方"
    },
    {
      "start": 196.12,
      "end": 196.84,
      "text": "第二步"
    },
    {
      "start": 196.84,
      "end": 198.44,
      "text": "照顾好自己的真实需求"
    },
    {
      "start": 198.44,
      "end": 199.24,
      "text": "不要把婚姻里"
    },
    {
      "start": 199.24,
      "end": 201.2,
      "text": "所有希望都压在对方身上"
    },
    {
      "start": 201.2,
      "end": 202.6,
      "text": "很多人结婚以后"
    },
    {
      "start": 202.6,
      "end": 203.76,
      "text": "会不知不觉"
    },
    {
      "start": 203.76,
      "end": 205.76,
      "text": "把伴侣变成唯一的情绪出口"
    },
    {
      "start": 205.76,
      "end": 206.76,
      "text": "工作不顺"
    },
    {
      "start": 206.76,
      "end": 208.76,
      "text": "希望对方立刻安慰家务和孩子"
    },
    {
      "start": 208.76,
      "end": 209.88,
      "text": "让自己疲惫"
    },
    {
      "start": 209.88,
      "end": 211.08,
      "text": "希望对方不用提醒"
    },
    {
      "start": 211.08,
      "end": 212.16,
      "text": "就主动分担"
    },
    {
      "start": 212.16,
      "end": 213.28,
      "text": "心里没有安全感"
    },
    {
      "start": 213.28,
      "end": 215.2,
      "text": "就期待对方随时报告行踪"
    },
    {
      "start": 215.2,
      "end": 216.2,
      "text": "随时回应消息"
    },
    {
      "start": 216.2,
      "end": 217.36,
      "text": "这里面有些确实是"
    },
    {
      "start": 217.36,
      "end": 218.92,
      "text": "婚姻中的合理需求"
    },
    {
      "start": 218.92,
      "end": 220.92,
      "text": "尤其是尊重 陪伴"
    },
    {
      "start": 220.92,
      "end": 222.0,
      "text": "共同承担"
    },
    {
      "start": 222.0,
      "end": 222.88,
      "text": "和基本回应"
    },
    {
      "start": 222.88,
      "end": 224.16,
      "text": "不应该被简单说成"
    },
    {
      "start": 224.16,
      "end": 225.0,
      "text": "你太依赖"
    },
    {
      "start": 225.0,
      "end": 226.04,
      "text": "但也要看见"
    },
    {
      "start": 226.04,
      "end": 227.08,
      "text": "没有任何一个人"
    },
    {
      "start": 227.08,
      "end": 228.4,
      "text": "能实实苛刻猜中"
    },
    {
      "start": 228.4,
      "end": 229.56,
      "text": "另一个人的心思"
    },
    {
      "start": 229.56,
      "end": 230.88,
      "text": "更不可能独自填补"
    },
    {
      "start": 230.88,
      "end": 231.84,
      "text": "对方所有的空缺"
    },
    {
      "start": 231.84,
      "end": 233.56,
      "text": "所以你需要把需求说清楚"
    },
    {
      "start": 233.56,
      "end": 235.04,
      "text": "也要给自己建立支撑"
    },
    {
      "start": 235.04,
      "end": 236.16,
      "text": "觉得生活被婚姻"
    },
    {
      "start": 236.16,
      "end": 237.68,
      "text": "急得只剩家务和争吵"
    },
    {
      "start": 237.68,
      "end": 239.92,
      "text": "就重新安排一点属于自己的时间"
    },
    {
      "start": 239.92,
      "end": 240.8,
      "text": "觉得孤单"
    },
    {
      "start": 240.8,
      "end": 242.76,
      "text": "可以恢复和朋友的联系"
    },
    {
      "start": 242.76,
      "end": 243.52,
      "text": "发展兴趣"
    },
    {
      "start": 243.52,
      "end": 245.64,
      "text": "保持工作和生活中的成长"
    },
    {
      "start": 245.64,
      "end": 246.48,
      "text": "压力太大"
    },
    {
      "start": 246.48,
      "end": 248.48,
      "text": "也可以和伴侣重新分配家务"
    },
    {
      "start": 248.48,
      "end": 250.12,
      "text": "预儿和经济责任"
    },
    {
      "start": 250.12,
      "end": 252.08,
      "text": "而不是一味忍到爆发"
    },
    {
      "start": 252.08,
      "end": 252.96,
      "text": "你可能会问"
    },
    {
      "start": 252.96,
      "end": 254.08,
      "text": "那我都能照顾自己了"
    },
    {
      "start": 254.08,
      "end": 255.24,
      "text": "还有婚姻干什么"
    },
    {
      "start": 255.24,
      "end": 256.92,
      "text": "独立不是不需要伴侣"
    },
    {
      "start": 256.92,
      "end": 259.36,
      "text": "而是不把自己的全部价值和情绪"
    },
    {
      "start": 259.36,
      "end": 260.92,
      "text": "都交给对方的一个表情"
    },
    {
      "start": 260.92,
      "end": 261.84,
      "text": "一句话来决定"
    },
    {
      "start": 261.84,
      "end": 263.32,
      "text": "我可以为自己的生活负责"
    },
    {
      "start": 263.32,
      "end": 264.96,
      "text": "也愿意和你互相扶持"
    },
    {
      "start": 264.96,
      "end": 265.96,
      "text": "我有需要会表达"
    },
    {
      "start": 265.96,
      "end": 267.92,
      "text": "但不会用失控逼你证明爱"
    },
    {
      "start": 267.92,
      "end": 269.04,
      "text": "你也有压力和边界"
    },
    {
      "start": 269.04,
      "end": 270.0,
      "text": "可以坦诚说出来"
    },
    {
      "start": 270.0,
      "end": 271.28,
      "text": "而不是用沉默让我猜"
    },
    {
      "start": 271.28,
      "end": 272.76,
      "text": "当两个人都不再把对方"
    },
    {
      "start": 272.76,
      "end": 274.24,
      "text": "当成唯一的情绪救援者"
    },
    {
      "start": 274.24,
      "end": 275.64,
      "text": "才有余力成为彼此"
    },
    {
      "start": 275.64,
      "end": 276.76,
      "text": "真正的支持"
    },
    {
      "start": 276.76,
      "end": 277.36,
      "text": "第三步"
    },
    {
      "start": 277.36,
      "end": 279.44,
      "text": "别让情绪成为婚姻里的主角"
    },
    {
      "start": 279.44,
      "end": 281.16,
      "text": "要学着做自己情绪的主人"
    },
    {
      "start": 281.16,
      "end": 282.48,
      "text": "心理学家弗兰克尔"
    },
    {
      "start": 282.48,
      "end": 284.04,
      "text": "有一句很有力量的话"
    },
    {
      "start": 284.04,
      "end": 285.6,
      "text": "人在任何处境中"
    },
    {
      "start": 285.6,
      "end": 287.88,
      "text": "都仍然拥有选择自己态度的自由"
    },
    {
      "start": 287.88,
      "end": 289.52,
      "text": "放在夫妻关系里"
    },
    {
      "start": 289.52,
      "end": 291.56,
      "text": "就是你可以选择立刻反击"
    },
    {
      "start": 291.56,
      "end": 292.84,
      "text": "也可以先缓一缓"
    },
    {
      "start": 292.84,
      "end": 294.76,
      "text": "可以用冷战让对方难受"
    },
    {
      "start": 294.76,
      "end": 295.92,
      "text": "也可以告诉对方"
    },
    {
      "start": 295.92,
      "end": 297.08,
      "text": "我现在情绪很满"
    },
    {
      "start": 297.08,
      "end": 298.28,
      "text": "想冷静半小时"
    },
    {
      "start": 298.28,
      "end": 299.76,
      "text": "之后我们把这件事谈完"
    },
    {
      "start": 299.76,
      "end": 300.36,
      "text": "注意"
    },
    {
      "start": 300.36,
      "end": 301.8,
      "text": "暂停不是消失"
    },
    {
      "start": 301.8,
      "end": 302.88,
      "text": "更不是用不回应"
    },
    {
      "start": 302.88,
      "end": 303.96,
      "text": "来惩罚对方"
    },
    {
      "start": 303.96,
      "end": 305.52,
      "text": "真正有效的暂停"
    },
    {
      "start": 305.52,
      "end": 306.56,
      "text": "要说清楚原因"
    },
    {
      "start": 306.56,
      "end": 308.32,
      "text": "也要约定什么时候回来继续谈"
    },
    {
      "start": 308.32,
      "end": 308.8,
      "text": "否则"
    },
    {
      "start": 308.8,
      "end": 310.04,
      "text": "一方以为是在冷静"
    },
    {
      "start": 310.04,
      "end": 311.04,
      "text": "另一方感受到的"
    },
    {
      "start": 311.04,
      "end": 312.16,
      "text": "却可能是被抛下"
    },
    {
      "start": 312.16,
      "end": 313.44,
      "text": "那些真正有能力"
    },
    {
      "start": 313.44,
      "end": 314.36,
      "text": "经营婚姻的人"
    },
    {
      "start": 314.36,
      "end": 315.88,
      "text": "并不是永远不争吵"
    },
    {
      "start": 315.88,
      "end": 317.88,
      "text": "也不是靠技巧让对方服软"
    },
    {
      "start": 317.88,
      "end": 318.72,
      "text": "他们知道"
    },
    {
      "start": 318.72,
      "end": 319.92,
      "text": "关系里的主动权"
    },
    {
      "start": 319.92,
      "end": 320.96,
      "text": "不是控制办理"
    },
    {
      "start": 320.96,
      "end": 322.4,
      "text": "而是管理自己的反应"
    },
    {
      "start": 322.4,
      "end": 324.2,
      "text": "同时为自己的行为负责"
    },
    {
      "start": 324.2,
      "end": 325.2,
      "text": "该表达时"
    },
    {
      "start": 325.2,
      "end": 327.32,
      "text": "把事实和感受讲清楚"
    },
    {
      "start": 327.32,
      "end": 328.2,
      "text": "该倾听时"
    },
    {
      "start": 328.2,
      "end": 329.32,
      "text": "先别急着辩解"
    },
    {
      "start": 329.32,
      "end": 330.32,
      "text": "试着理解对方"
    },
    {
      "start": 330.32,
      "end": 331.36,
      "text": "为什么这样想"
    },
    {
      "start": 331.36,
      "end": 332.64,
      "text": "需要道歉时不拿"
    },
    {
      "start": 332.64,
      "end": 333.64,
      "text": "我都是为了这个家"
    },
    {
      "start": 333.64,
      "end": 334.56,
      "text": "当挡箭牌"
    },
    {
      "start": 334.56,
      "end": 335.44,
      "text": "受到伤害时"
    },
    {
      "start": 335.44,
      "end": 336.56,
      "text": "也不假装没发生"
    },
    {
      "start": 336.56,
      "end": 338.16,
      "text": "而是明确告诉对方"
    },
    {
      "start": 338.16,
      "end": 339.72,
      "text": "什么行为不能继续"
    },
    {
      "start": 339.72,
      "end": 341.08,
      "text": "婚姻修复不是一个人"
    },
    {
      "start": 341.08,
      "end": 342.24,
      "text": "单方面改变"
    },
    {
      "start": 342.24,
      "end": 343.4,
      "text": "也不是谁先低头"
    },
    {
      "start": 343.4,
      "end": 344.32,
      "text": "谁就输了"
    },
    {
      "start": 344.32,
      "end": 345.2,
      "text": "而是两个人"
    },
    {
      "start": 345.2,
      "end": 347.0,
      "text": "愿不愿意一起面对问题"
    },
    {
      "start": 347.0,
      "end": 348.2,
      "text": "调整相处方式"
    },
    {
      "start": 348.2,
      "end": 349.32,
      "text": "当你们下一次"
    },
    {
      "start": 349.32,
      "end": 350.16,
      "text": "又陷入将局"
    },
    {
      "start": 350.16,
      "end": 351.12,
      "text": "不妨把争论"
    },
    {
      "start": 351.12,
      "end": 352.32,
      "text": "从你到底爱不爱我"
    },
    {
      "start": 352.32,
      "end": 353.76,
      "text": "拉回眼前之间具体的事"
    },
    {
      "start": 353.76,
      "end": 354.6,
      "text": "可以约定每个人"
    },
    {
      "start": 354.6,
      "end": 355.44,
      "text": "先说几分钟"
    },
    {
      "start": 355.44,
      "end": 356.0,
      "text": "不打断"
    },
    {
      "start": 356.0,
      "end": 356.96,
      "text": "不讽刺"
    },
    {
      "start": 356.96,
      "end": 358.36,
      "text": "也不急着下结论"
    },
    {
      "start": 358.36,
      "end": 359.08,
      "text": "听完以后"
    },
    {
      "start": 359.08,
      "end": 360.96,
      "text": "先复述自己听到的重点"
    },
    {
      "start": 360.96,
      "end": 362.6,
      "text": "再说自己的感受和希望"
    },
    {
      "start": 362.6,
      "end": 363.8,
      "text": "若问题反复出现"
    },
    {
      "start": 363.8,
      "end": 365.16,
      "text": "靠一次谈话解决不了"
    },
    {
      "start": 365.16,
      "end": 367.12,
      "text": "就把它拆成能落实的小改变"
    },
    {
      "start": 367.12,
      "end": 368.36,
      "text": "比如每天留出一段"
    },
    {
      "start": 368.36,
      "end": 369.92,
      "text": "不被手机打断的交流时间"
    },
    {
      "start": 369.92,
      "end": 371.56,
      "text": "或把家里的责任重新分配"
    },
    {
      "start": 371.56,
      "end": 372.8,
      "text": "如果双方已经长期"
    },
    {
      "start": 372.8,
      "end": 374.6,
      "text": "现在冷战 羞辱 威胁"
    },
    {
      "start": 374.6,
      "end": 375.88,
      "text": "或反复伤害力"
    },
    {
      "start": 375.88,
      "end": 377.08,
      "text": "也可以寻求婚姻咨询"
    },
    {
      "start": 377.08,
      "end": 378.24,
      "text": "等专业支持"
    },
    {
      "start": 378.24,
      "end": 379.92,
      "text": "涉及暴力或人身安全时"
    },
    {
      "start": 379.92,
      "end": 381.24,
      "text": "优先保护自己"
    },
    {
      "start": 381.24,
      "end": 383.2,
      "text": "不必为了维持关系而独自承受"
    }
  ]
}