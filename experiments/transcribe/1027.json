{
  "file": "E:\\彬\\1027.mp4",
  "language": "zh",
  "duration": 291.99,
  "segments": [
    {
      "start": 0.0,
      "end": 1.2,
      "text": "妻子出过鬼"
    },
    {
      "start": 1.2,
      "end": 3.48,
      "text": "如果没有帮老公把心里的根刺拔出来"
    },
    {
      "start": 3.48,
      "end": 5.64,
      "text": "夫妻关系是不可能真正变好"
    },
    {
      "start": 5.64,
      "end": 7.68,
      "text": "很多朋友跟我说"
    },
    {
      "start": 7.68,
      "end": 9.28,
      "text": "遭遇妻子不忠之后"
    },
    {
      "start": 9.28,
      "end": 11.08,
      "text": "两个人都想好好过日子"
    },
    {
      "start": 11.08,
      "end": 12.36,
      "text": "丈夫明明知道"
    },
    {
      "start": 12.36,
      "end": 13.68,
      "text": "老婆已经回头"
    },
    {
      "start": 13.68,
      "end": 15.64,
      "text": "和外面的人也彻底断干净了"
    },
    {
      "start": 15.64,
      "end": 17.64,
      "text": "可心里那道坎就是垮不过去"
    },
    {
      "start": 17.64,
      "end": 18.96,
      "text": "控制不住胡思乱想"
    },
    {
      "start": 18.96,
      "end": 20.2,
      "text": "情绪反反复复"
    },
    {
      "start": 20.2,
      "end": 21.68,
      "text": "一会儿觉得日子还能继续"
    },
    {
      "start": 21.68,
      "end": 23.64,
      "text": "以后又内心个影想要离婚"
    },
    {
      "start": 23.64,
      "end": 25.08,
      "text": "这种来回拉扯的折磨"
    },
    {
      "start": 25.08,
      "end": 26.68,
      "text": "不光丈夫自己活得很累"
    },
    {
      "start": 26.68,
      "end": 28.2,
      "text": "妻子也被手煎熬"
    },
    {
      "start": 28.28,
      "end": 30.12,
      "text": "整个家长期此气沉沉"
    },
    {
      "start": 30.12,
      "end": 31.16,
      "text": "其实这就是背叛"
    },
    {
      "start": 31.16,
      "end": 32.96,
      "text": "带来的创伤后的应激反应"
    },
    {
      "start": 32.96,
      "end": 34.2,
      "text": "男人遭遇背叛之后"
    },
    {
      "start": 34.2,
      "end": 36.04,
      "text": "大脑会开启自我保护机制"
    },
    {
      "start": 36.04,
      "end": 38.64,
      "text": "他会不受控制的反复复盘过往的细节"
    },
    {
      "start": 38.64,
      "end": 39.88,
      "text": "就算你闭口不提"
    },
    {
      "start": 39.88,
      "end": 42.56,
      "text": "大脑子里会自动回放那些伤人的画面"
    },
    {
      "start": 42.56,
      "end": 43.6,
      "text": "这不是他小气"
    },
    {
      "start": 43.6,
      "end": 44.92,
      "text": "也不是他不爱这个家"
    },
    {
      "start": 44.92,
      "end": 46.44,
      "text": "而是他的大脑在用这种方式"
    },
    {
      "start": 46.44,
      "end": 48.4,
      "text": "提醒自己不要再受到二次伤害"
    },
    {
      "start": 48.4,
      "end": 50.2,
      "text": "所以当他情绪因情不定的时候"
    },
    {
      "start": 50.2,
      "end": 50.96,
      "text": "你要明白"
    },
    {
      "start": 50.96,
      "end": 52.6,
      "text": "这是心里的伤口在发言"
    },
    {
      "start": 52.6,
      "end": 54.28,
      "text": "并不是他故意找茶刁难你"
    },
    {
      "start": 54.28,
      "end": 55.92,
      "text": "很多妻子这个时候最容易踩坑"
    },
    {
      "start": 55.96,
      "end": 56.68,
      "text": "心里会想"
    },
    {
      "start": 56.68,
      "end": 57.68,
      "text": "我都已经认错了"
    },
    {
      "start": 57.68,
      "end": 58.88,
      "text": "你到底还要我怎么样"
    },
    {
      "start": 58.88,
      "end": 60.8,
      "text": "一旦抱着这种心态去相处"
    },
    {
      "start": 60.8,
      "end": 62.4,
      "text": "只会加重他的心理传伤"
    },
    {
      "start": 62.4,
      "end": 63.2,
      "text": "在他眼里"
    },
    {
      "start": 63.2,
      "end": 65.6,
      "text": "你的道歉只能了解过去犯下的错"
    },
    {
      "start": 65.6,
      "end": 68.2,
      "text": "可他当下要承受的是往后几十年的恐惧"
    },
    {
      "start": 68.2,
      "end": 69.52,
      "text": "他害怕你重蹈覆辙"
    },
    {
      "start": 69.52,
      "end": 70.52,
      "text": "害怕难堪"
    },
    {
      "start": 70.52,
      "end": 72.04,
      "text": "害怕旁人的直直点点"
    },
    {
      "start": 72.04,
      "end": 73.84,
      "text": "这份恐惧感光靠几句我爱你"
    },
    {
      "start": 73.84,
      "end": 74.92,
      "text": "是压不下去的"
    },
    {
      "start": 74.92,
      "end": 76.48,
      "text": "想要拔掉心理这根刺"
    },
    {
      "start": 76.48,
      "end": 78.16,
      "text": "而是嘴上安抚远远不够"
    },
    {
      "start": 78.16,
      "end": 79.52,
      "text": "核心是实实在在"
    },
    {
      "start": 79.52,
      "end": 80.8,
      "text": "重建他的安全感"
    },
    {
      "start": 80.8,
      "end": 82.32,
      "text": "这份安全感不是嘴上一句"
    },
    {
      "start": 82.32,
      "end": 83.68,
      "text": "我会改就能换来的"
    },
    {
      "start": 86.08,
      "end": 87.08,
      "text": "一点点堆出来"
    },
    {
      "start": 87.08,
      "end": 87.8,
      "text": "举个例子"
    },
    {
      "start": 87.8,
      "end": 88.6,
      "text": "他突然问"
    },
    {
      "start": 88.6,
      "end": 90.36,
      "text": "你那天为什么晚回家半小时"
    },
    {
      "start": 90.36,
      "end": 91.0,
      "text": "哪怕"
    },
    {
      "start": 91.0,
      "end": 92.76,
      "text": "这件事人已经解释过一百遍"
    },
    {
      "start": 92.76,
      "end": 93.96,
      "text": "他焦虑发作的时候"
    },
    {
      "start": 93.96,
      "end": 94.96,
      "text": "你依旧要耐下心"
    },
    {
      "start": 94.96,
      "end": 96.4,
      "text": "再解释第一百零一遍"
    },
    {
      "start": 96.4,
      "end": 97.84,
      "text": "他要的是一份确定的答复"
    },
    {
      "start": 97.84,
      "end": 99.28,
      "text": "来凭分内心的恐慌"
    },
    {
      "start": 99.28,
      "end": 100.52,
      "text": "如果你表现出不耐烦"
    },
    {
      "start": 100.52,
      "end": 102.76,
      "text": "他心底的怀疑瞬间会放大一倍"
    },
    {
      "start": 102.76,
      "end": 104.08,
      "text": "还有绕不开的一点"
    },
    {
      "start": 104.08,
      "end": 105.52,
      "text": "被背叛对男人的自尊心"
    },
    {
      "start": 105.52,
      "end": 106.8,
      "text": "是毁灭性打击"
    },
    {
      "start": 106.8,
      "end": 108.2,
      "text": "他会变得格外敏感"
    },
    {
      "start": 108.2,
      "end": 109.52,
      "text": "在一旁人的眼光"
    },
    {
      "start": 109.52,
      "end": 110.88,
      "text": "甚至有些神经质"
    },
    {
      "start": 110.88,
      "end": 111.8,
      "text": "这个阶段"
    },
    {
      "start": 111.88,
      "end": 113.92,
      "text": "你要给到他足够的尊重与面子"
    },
    {
      "start": 113.92,
      "end": 114.84,
      "text": "在外人面前"
    },
    {
      "start": 114.84,
      "end": 116.64,
      "text": "多展现出对他的依赖和看重"
    },
    {
      "start": 116.64,
      "end": 117.52,
      "text": "让他感受到"
    },
    {
      "start": 117.52,
      "end": 118.76,
      "text": "在家里他是有地位"
    },
    {
      "start": 118.76,
      "end": 120.4,
      "text": "被需要的不是让你演戏"
    },
    {
      "start": 120.4,
      "end": 121.52,
      "text": "而是让他真切感受到"
    },
    {
      "start": 121.52,
      "end": 123.64,
      "text": "自己依旧是被坚定选择的那个人"
    },
    {
      "start": 123.64,
      "end": 124.72,
      "text": "不少气质会说"
    },
    {
      "start": 124.72,
      "end": 126.2,
      "text": "既然决定重新开始"
    },
    {
      "start": 126.2,
      "end": 127.8,
      "text": "能不能就不要带翻球仗了"
    },
    {
      "start": 127.8,
      "end": 128.84,
      "text": "可现实是"
    },
    {
      "start": 128.84,
      "end": 130.44,
      "text": "只要他没有真正释怀"
    },
    {
      "start": 130.44,
      "end": 131.28,
      "text": "这件伤"
    },
    {
      "start": 131.28,
      "end": 132.6,
      "text": "就会一直摆在那里"
    },
    {
      "start": 132.6,
      "end": 134.44,
      "text": "你要主动创造安全的沟通氛围"
    },
    {
      "start": 134.44,
      "end": 136.2,
      "text": "引导他把心理挤压的委屈"
    },
    {
      "start": 136.2,
      "end": 137.28,
      "text": "全部说出来"
    },
    {
      "start": 137.28,
      "end": 138.68,
      "text": "男人大多不习惯倾诉"
    },
    {
      "start": 138.68,
      "end": 139.76,
      "text": "被在心底的怨气"
    },
    {
      "start": 139.76,
      "end": 141.28,
      "text": "最后就会化作冷暴力"
    },
    {
      "start": 141.28,
      "end": 142.4,
      "text": "要给他机会"
    },
    {
      "start": 142.4,
      "end": 143.68,
      "text": "允许他对你失望"
    },
    {
      "start": 143.68,
      "end": 144.48,
      "text": "生气"
    },
    {
      "start": 144.48,
      "end": 145.4,
      "text": "说出自己"
    },
    {
      "start": 145.4,
      "end": 146.48,
      "text": "到底有多痛"
    },
    {
      "start": 146.48,
      "end": 147.48,
      "text": "只有把心里的农血"
    },
    {
      "start": 147.48,
      "end": 148.6,
      "text": "全部宣泄出来"
    },
    {
      "start": 148.6,
      "end": 150.04,
      "text": "伤口才有愈合的可能"
    },
    {
      "start": 150.04,
      "end": 150.92,
      "text": "他情绪爆发"
    },
    {
      "start": 150.92,
      "end": 151.92,
      "text": "指责你的时候"
    },
    {
      "start": 151.92,
      "end": 152.92,
      "text": "不要顶嘴反驳"
    },
    {
      "start": 152.92,
      "end": 154.64,
      "text": "也不要哭诉自己生不由己"
    },
    {
      "start": 154.64,
      "end": 155.96,
      "text": "你只需要轻轻看见"
    },
    {
      "start": 155.96,
      "end": 157.64,
      "text": "并且承认他承受的痛苦"
    },
    {
      "start": 157.64,
      "end": 158.56,
      "text": "告诉他你清楚"
    },
    {
      "start": 158.56,
      "end": 160.04,
      "text": "这件事对他太不公平"
    },
    {
      "start": 160.04,
      "end": 160.88,
      "text": "重建信任"
    },
    {
      "start": 160.88,
      "end": 162.28,
      "text": "是一场漫长的修行"
    },
    {
      "start": 162.28,
      "end": 163.8,
      "text": "甚至可能要耗匪好几年"
    },
    {
      "start": 163.8,
      "end": 165.6,
      "text": "这个阶段你必须做到主动透明"
    },
    {
      "start": 165.6,
      "end": 167.0,
      "text": "手机可以随时看行踪"
    },
    {
      "start": 167.0,
      "end": 167.96,
      "text": "主动报备"
    },
    {
      "start": 167.96,
      "end": 169.88,
      "text": "却不应该成为你们吵架的导弧所"
    },
    {
      "start": 169.88,
      "end": 171.84,
      "text": "而是你主动递出去的定心计"
    },
    {
      "start": 171.84,
      "end": 172.88,
      "text": "很多女人会觉得"
    },
    {
      "start": 172.88,
      "end": 174.52,
      "text": "这么做侵犯自己的隐私"
    },
    {
      "start": 174.52,
      "end": 175.68,
      "text": "凭什么要我这样"
    },
    {
      "start": 175.68,
      "end": 176.96,
      "text": "但你要认清现实"
    },
    {
      "start": 176.96,
      "end": 178.92,
      "text": "是你打破了婚姻原本的平衡"
    },
    {
      "start": 178.92,
      "end": 181.32,
      "text": "修复关系本就该由你来承担代价"
    },
    {
      "start": 181.32,
      "end": 183.12,
      "text": "这份透明不是为了被监视"
    },
    {
      "start": 183.12,
      "end": 184.52,
      "text": "而是让他时刻紧绷"
    },
    {
      "start": 184.52,
      "end": 185.72,
      "text": "随时防卫的那个心"
    },
    {
      "start": 185.72,
      "end": 187.0,
      "text": "可以慢慢放下来"
    },
    {
      "start": 187.0,
      "end": 188.44,
      "text": "老公情绪反复的时候"
    },
    {
      "start": 188.44,
      "end": 189.92,
      "text": "千万不要跟他硬碰硬"
    },
    {
      "start": 189.92,
      "end": 191.04,
      "text": "他今天状态差"
    },
    {
      "start": 191.04,
      "end": 192.36,
      "text": "就不要去招惹他"
    },
    {
      "start": 192.4,
      "end": 193.8,
      "text": "但明天情绪缓和"
    },
    {
      "start": 193.8,
      "end": 195.4,
      "text": "你也不要急着体合好的要求"
    },
    {
      "start": 195.4,
      "end": 196.72,
      "text": "一切顺着他的节奏来"
    },
    {
      "start": 196.72,
      "end": 198.36,
      "text": "就像照顾一个受伤的病人"
    },
    {
      "start": 198.36,
      "end": 199.84,
      "text": "你不能强迫他也是痊愈"
    },
    {
      "start": 199.84,
      "end": 201.36,
      "text": "但难受的时候多一分体量"
    },
    {
      "start": 201.36,
      "end": 203.44,
      "text": "他烦躁的时候适当保持距离"
    },
    {
      "start": 203.44,
      "end": 204.4,
      "text": "还有一个大姐"
    },
    {
      "start": 204.4,
      "end": 205.8,
      "text": "不要拿孩子绑架他"
    },
    {
      "start": 205.8,
      "end": 207.76,
      "text": "也不要拿过去的恩情道的绑架他"
    },
    {
      "start": 207.76,
      "end": 209.44,
      "text": "不要说为了孩子就错后过吧"
    },
    {
      "start": 209.44,
      "end": 211.44,
      "text": "也不要总提起以前我对你有多好"
    },
    {
      "start": 211.44,
      "end": 213.16,
      "text": "这些话只会让他更加压抑"
    },
    {
      "start": 213.16,
      "end": 214.8,
      "text": "他当下的痛苦真实存在"
    },
    {
      "start": 214.8,
      "end": 217.08,
      "text": "拿从先的好去抵消现在的伤害"
    },
    {
      "start": 217.08,
      "end": 219.24,
      "text": "本质上就是在否定他的感受"
    },
    {
      "start": 219.24,
      "end": 220.96,
      "text": "他不需要你提醒他理智一点"
    },
    {
      "start": 220.96,
      "end": 222.12,
      "text": "他需要的是你陪着他"
    },
    {
      "start": 222.12,
      "end": 224.24,
      "text": "熬过这段失去理智的简单时期"
    },
    {
      "start": 224.24,
      "end": 226.16,
      "text": "如果你不知道在漫长的修复期底"
    },
    {
      "start": 226.16,
      "end": 227.92,
      "text": "该怎么一点点找回信任"
    },
    {
      "start": 227.92,
      "end": 229.68,
      "text": "怎么把关系慢慢升温"
    },
    {
      "start": 229.68,
      "end": 231.52,
      "text": "修复是有完整路径的"
    },
    {
      "start": 231.52,
      "end": 233.08,
      "text": "我整理好了实战案例"
    },
    {
      "start": 233.08,
      "end": 234.72,
      "text": "从打破彼此之间的隔阂"
    },
    {
      "start": 234.72,
      "end": 236.2,
      "text": "到一步步重建信任"
    },
    {
      "start": 236.2,
      "end": 237.44,
      "text": "全部处理清楚"
    },
    {
      "start": 237.44,
      "end": 238.96,
      "text": "想要的评论区留三"
    },
    {
      "start": 238.96,
      "end": 240.72,
      "text": "李老师看到之后会给你回复"
    },
    {
      "start": 240.72,
      "end": 241.92,
      "text": "最后想跟妻子们说"
    },
    {
      "start": 241.92,
      "end": 243.8,
      "text": "如果你真心想要挽回这段欢迎"
    },
    {
      "start": 243.8,
      "end": 245.68,
      "text": "就要做好打持久战的心理准备"
    },
    {
      "start": 245.68,
      "end": 247.04,
      "text": "这根刺扎的太神"
    },
    {
      "start": 247.04,
      "end": 249.48,
      "text": "拔出来的时候一定会连带着撕下一块肉"
    },
    {
      "start": 249.48,
      "end": 251.48,
      "text": "过程会煎熬 会委屈"
    },
    {
      "start": 251.48,
      "end": 253.72,
      "text": "甚至会让你怀疑回归家庭这个选择"
    },
    {
      "start": 253.72,
      "end": 254.8,
      "text": "到底值不值得"
    },
    {
      "start": 254.8,
      "end": 256.88,
      "text": "但这就是你回头所要承担的代价"
    },
    {
      "start": 256.88,
      "end": 258.8,
      "text": "如果这点委屈你都承受不住"
    },
    {
      "start": 258.8,
      "end": 260.76,
      "text": "那这根刺就会永远留在婚姻里"
    },
    {
      "start": 260.76,
      "end": 262.92,
      "text": "早晚有一天会彻底摧毁你们的家"
    },
    {
      "start": 262.92,
      "end": 264.48,
      "text": "也想对丈夫说一句"
    },
    {
      "start": 264.48,
      "end": 266.28,
      "text": "如果你也选择继续走下去"
    },
    {
      "start": 266.28,
      "end": 268.68,
      "text": "也试着看见妻子实实在在的改变"
    },
    {
      "start": 268.68,
      "end": 270.44,
      "text": "倘若她真的在努力修正"
    },
    {
      "start": 270.44,
      "end": 272.0,
      "text": "也不要一直揪着过往不放"
    },
    {
      "start": 272.0,
      "end": 273.2,
      "text": "日子总要向前走"
    },
    {
      "start": 273.2,
      "end": 274.6,
      "text": "伤口终会结家"
    },
    {
      "start": 274.6,
      "end": 277.24,
      "text": "别让过去的错误消耗往后几十年的生活"
    },
    {
      "start": 277.24,
      "end": 279.0,
      "text": "家终究是讲爱的地方"
    },
    {
      "start": 279.0,
      "end": 280.6,
      "text": "而不是一味讲道理的地方"
    },
    {
      "start": 280.6,
      "end": 282.64,
      "text": "当你看见她因为你的反复情绪"
    },
    {
      "start": 282.64,
      "end": 284.08,
      "text": "获得小心翼翼的时候"
    },
    {
      "start": 284.08,
      "end": 285.48,
      "text": "不妨主动第一个台阶"
    },
    {
      "start": 285.48,
      "end": 287.68,
      "text": "两个人一起翻过这黑暗的一夜"
    },
    {
      "start": 287.68,
      "end": 289.72,
      "text": "远比一个人硬扛要轻松的多"
    },
    {
      "start": 289.72,
      "end": 290.64,
      "text": "这些就到这里"
    },
    {
      "start": 290.64,
      "end": 291.84,
      "text": "有问题随时继续离安"
    }
  ]
}