{
  "file": "E:\\音频素材\\116.mp4",
  "language": "zh",
  "duration": 205.15,
  "segments": [
    {
      "start": 0.0,
      "end": 1.92,
      "text": "伴侣反复追问犯错细节"
    },
    {
      "start": 1.92,
      "end": 3.48,
      "text": "这其实是一种刺旧"
    },
    {
      "start": 3.48,
      "end": 5.12,
      "text": "搭建伴侣犯错之后"
    },
    {
      "start": 5.12,
      "end": 8.0,
      "text": "被伤害的一方往往会不停追问各种细节"
    },
    {
      "start": 8.0,
      "end": 11.08,
      "text": "你可能觉得它是揪着这件事不放"
    },
    {
      "start": 11.08,
      "end": 13.32,
      "text": "故意折磨你 也折磨它自己"
    },
    {
      "start": 13.32,
      "end": 15.44,
      "text": "但今天也安想请你换一个角度"
    },
    {
      "start": 15.44,
      "end": 17.6,
      "text": "读懂这些追问背后真正的声音"
    },
    {
      "start": 17.6,
      "end": 19.48,
      "text": "这些看似折腾的追问之下"
    },
    {
      "start": 19.48,
      "end": 22.24,
      "text": "藏着三个你从来没有读懂过的真相"
    },
    {
      "start": 22.24,
      "end": 24.6,
      "text": "看懂这些你才知道该怎么回应"
    },
    {
      "start": 24.6,
      "end": 27.56,
      "text": "才能真正帮到它一起跨过这道坎"
    },
    {
      "start": 27.56,
      "end": 28.84,
      "text": "守住这段回音"
    },
    {
      "start": 28.84,
      "end": 30.32,
      "text": "在讲这三个真相之前"
    },
    {
      "start": 30.32,
      "end": 31.92,
      "text": "不妨尽量先问自己一句"
    },
    {
      "start": 31.92,
      "end": 33.56,
      "text": "它一遍遍追问细节"
    },
    {
      "start": 33.56,
      "end": 35.32,
      "text": "最根本的目的是什么"
    },
    {
      "start": 35.32,
      "end": 37.16,
      "text": "是为了报复你 让你难受"
    },
    {
      "start": 37.16,
      "end": 39.4,
      "text": "还是收集证据 准备分开"
    },
    {
      "start": 39.4,
      "end": 41.68,
      "text": "其实答案是 它是在自救"
    },
    {
      "start": 41.68,
      "end": 44.76,
      "text": "是在给这段快要撑不住的回音寻找一个答案"
    },
    {
      "start": 44.76,
      "end": 47.76,
      "text": "判断这段关系到底还能不能继续走下去"
    },
    {
      "start": 47.76,
      "end": 49.28,
      "text": "真相依 它要细节"
    },
    {
      "start": 49.28,
      "end": 51.88,
      "text": "是为了让自己混乱的思绪停下来"
    },
    {
      "start": 51.88,
      "end": 55.04,
      "text": "把自己从独自被困的痛苦想象里拉出来"
    },
    {
      "start": 55.04,
      "end": 56.48,
      "text": "心理学里有一个概念叫"
    },
    {
      "start": 56.48,
      "end": 58.24,
      "text": "窗商应激反应"
    },
    {
      "start": 58.24,
      "end": 59.84,
      "text": "人遭受重大伤害之后"
    },
    {
      "start": 59.84,
      "end": 61.64,
      "text": "如果事情一直模糊不清"
    },
    {
      "start": 61.64,
      "end": 62.68,
      "text": "被特意隐瞒"
    },
    {
      "start": 62.68,
      "end": 65.04,
      "text": "大佬就会不受控制的反复回响"
    },
    {
      "start": 65.04,
      "end": 67.32,
      "text": "内耗 甚至脑补出远比"
    },
    {
      "start": 67.32,
      "end": 69.48,
      "text": "真实情况可怕很多的画面"
    },
    {
      "start": 69.48,
      "end": 71.08,
      "text": "你越是闭口不提"
    },
    {
      "start": 71.08,
      "end": 73.4,
      "text": "它越会往最坏的方向揣测"
    },
    {
      "start": 73.4,
      "end": 74.92,
      "text": "是不是早就开始了"
    },
    {
      "start": 74.92,
      "end": 77.64,
      "text": "是不是一切都是续谋已久"
    },
    {
      "start": 77.64,
      "end": 79.16,
      "text": "它追着询问细节"
    },
    {
      "start": 79.16,
      "end": 81.32,
      "text": "是想用一份确定"
    },
    {
      "start": 81.32,
      "end": 84.36,
      "text": "清晰的事实替代无边无际的猜疑"
    },
    {
      "start": 84.36,
      "end": 85.84,
      "text": "白团模糊的噩梦"
    },
    {
      "start": 85.88,
      "end": 87.44,
      "text": "变成一件具体的事"
    },
    {
      "start": 87.44,
      "end": 88.24,
      "text": "只有这样"
    },
    {
      "start": 88.24,
      "end": 90.52,
      "text": "无休止的自我消耗才能停下"
    },
    {
      "start": 90.52,
      "end": 92.04,
      "text": "你以为隐瞒是在保护它"
    },
    {
      "start": 92.04,
      "end": 92.88,
      "text": "实际上"
    },
    {
      "start": 92.88,
      "end": 94.32,
      "text": "是把它一个人丢在自己"
    },
    {
      "start": 94.32,
      "end": 95.72,
      "text": "不断脑补的痛苦里"
    },
    {
      "start": 95.72,
      "end": 96.4,
      "text": "真相二"
    },
    {
      "start": 96.4,
      "end": 97.28,
      "text": "它要细节"
    },
    {
      "start": 97.28,
      "end": 99.76,
      "text": "是帮你切断再次犯错的退路"
    },
    {
      "start": 99.76,
      "end": 101.72,
      "text": "让这份教训真正刻进心里"
    },
    {
      "start": 101.72,
      "end": 104.04,
      "text": "很多人觉得犯错之后道了歉"
    },
    {
      "start": 104.04,
      "end": 105.12,
      "text": "回归家庭"
    },
    {
      "start": 105.12,
      "end": 107.12,
      "text": "这一页就可以翻过去了"
    },
    {
      "start": 107.12,
      "end": 108.04,
      "text": "但事实上"
    },
    {
      "start": 108.04,
      "end": 109.44,
      "text": "要过细节的道歉"
    },
    {
      "start": 109.44,
      "end": 110.8,
      "text": "大多只是敷衍"
    },
    {
      "start": 110.8,
      "end": 112.76,
      "text": "只有当面弹开所有经过"
    },
    {
      "start": 112.76,
      "end": 114.76,
      "text": "完成碰撤心扉的反思"
    },
    {
      "start": 114.8,
      "end": 116.52,
      "text": "才算是真正的悔改"
    },
    {
      "start": 116.52,
      "end": 118.64,
      "text": "模糊的感受很容易随时间淡化"
    },
    {
      "start": 118.64,
      "end": 120.32,
      "text": "你也很容易再次重蹈覆辙"
    },
    {
      "start": 120.32,
      "end": 122.8,
      "text": "而清晰的经过具体的情节"
    },
    {
      "start": 122.8,
      "end": 124.64,
      "text": "会像一根刺流在心里"
    },
    {
      "start": 124.64,
      "end": 126.88,
      "text": "回想起来就能感受到这份伤痛"
    },
    {
      "start": 126.88,
      "end": 129.2,
      "text": "让你说出细节不是为了报复你"
    },
    {
      "start": 129.2,
      "end": 130.84,
      "text": "而是把当下的冲击"
    },
    {
      "start": 130.84,
      "end": 131.8,
      "text": "变成长久"
    },
    {
      "start": 131.8,
      "end": 133.28,
      "text": "警醒自己的教训"
    },
    {
      "start": 133.28,
      "end": 134.92,
      "text": "牢牢记住这份痛苦"
    },
    {
      "start": 134.92,
      "end": 136.08,
      "text": "才有可能克制住"
    },
    {
      "start": 136.08,
      "end": 137.6,
      "text": "再次犯错的念头"
    },
    {
      "start": 137.6,
      "end": 139.08,
      "text": "这既是对你的约束"
    },
    {
      "start": 139.08,
      "end": 140.72,
      "text": "也是在守护这个家"
    },
    {
      "start": 140.72,
      "end": 141.48,
      "text": "真相三"
    },
    {
      "start": 141.48,
      "end": 142.4,
      "text": "它要细节"
    },
    {
      "start": 142.4,
      "end": 143.96,
      "text": "是用爱判断这段婚姻"
    },
    {
      "start": 143.96,
      "end": 145.52,
      "text": "还值不值得继续修复"
    },
    {
      "start": 145.52,
      "end": 147.52,
      "text": "很多被伤害的班女跟我说"
    },
    {
      "start": 147.52,
      "end": 149.72,
      "text": "不停追问并不是故意找茶"
    },
    {
      "start": 149.72,
      "end": 150.88,
      "text": "只是想弄明白"
    },
    {
      "start": 150.88,
      "end": 152.4,
      "text": "你为什么会走到这一步"
    },
    {
      "start": 152.4,
      "end": 154.48,
      "text": "这个家还有没有修复的可能"
    },
    {
      "start": 154.48,
      "end": 157.04,
      "text": "它会通过你面对细节时的态度"
    },
    {
      "start": 157.04,
      "end": 158.64,
      "text": "判断你只是一世糊涂"
    },
    {
      "start": 158.64,
      "end": 160.84,
      "text": "还是从心底没有正式这段婚姻"
    },
    {
      "start": 160.84,
      "end": 163.48,
      "text": "如果你连坦诚说明了勇气都没有"
    },
    {
      "start": 163.48,
      "end": 164.32,
      "text": "它就会明白"
    },
    {
      "start": 164.32,
      "end": 165.6,
      "text": "你只是能回来了"
    },
    {
      "start": 165.6,
      "end": 166.88,
      "text": "心并没有回归"
    },
    {
      "start": 166.88,
      "end": 168.48,
      "text": "看不到悔改的诚意"
    },
    {
      "start": 168.48,
      "end": 170.8,
      "text": "它就会对这段婚姻彻底死心"
    },
    {
      "start": 170.8,
      "end": 172.84,
      "text": "它想要的从来不是很很惩罚你"
    },
    {
      "start": 172.84,
      "end": 175.04,
      "text": "而是给冰淋铺碎的婚姻"
    },
    {
      "start": 175.04,
      "end": 176.52,
      "text": "要一个清楚的说法"
    },
    {
      "start": 176.52,
      "end": 177.8,
      "text": "一个明确的未来"
    },
    {
      "start": 177.8,
      "end": 179.92,
      "text": "只要你愿意坦诚地和它一起挖出"
    },
    {
      "start": 179.92,
      "end": 180.92,
      "text": "问题根源"
    },
    {
      "start": 180.92,
      "end": 182.84,
      "text": "哪怕过程写零零很前"
    },
    {
      "start": 182.84,
      "end": 185.0,
      "text": "它也愿意再给这段婚姻一次机会"
    },
    {
      "start": 185.0,
      "end": 187.8,
      "text": "所以当班女再一次追问细节的时候"
    },
    {
      "start": 187.8,
      "end": 189.52,
      "text": "不要再想着敷衍回避"
    },
    {
      "start": 189.52,
      "end": 191.4,
      "text": "看在绝望里向你伸出的手"
    },
    {
      "start": 191.4,
      "end": 193.2,
      "text": "试围你的最后一道考题"
    },
    {
      "start": 193.2,
      "end": 194.52,
      "text": "你的坦诚和担当"
    },
    {
      "start": 194.52,
      "end": 196.12,
      "text": "就是接住这只手"
    },
    {
      "start": 196.12,
      "end": 197.84,
      "text": "打好这道题唯一的方式"
    },
    {
      "start": 197.84,
      "end": 200.08,
      "text": "修复婚姻的路从来都不容易"
    },
    {
      "start": 200.08,
      "end": 201.36,
      "text": "但真正的重建"
    },
    {
      "start": 201.44,
      "end": 204.04,
      "text": "本就是两个人一同直面满目创意"
    },
    {
      "start": 204.04,
      "end": 205.04,
      "text": "再重新出发"
    }
  ]
}