{
  "file": "E:\\音频素材\\1112.mp4",
  "language": "zh",
  "duration": 377.46,
  "segments": [
    {
      "start": 0.0,
      "end": 1.8,
      "text": "夫妻接纳了犯错的伴侣"
    },
    {
      "start": 1.8,
      "end": 3.4,
      "text": "却始终放不下怀疑"
    },
    {
      "start": 3.4,
      "end": 5.0,
      "text": "最智慧的做法是什么?"
    },
    {
      "start": 5.0,
      "end": 7.2,
      "text": "曾经你堵定她是好人"
    },
    {
      "start": 7.2,
      "end": 9.2,
      "text": "毫无保留交出真心"
    },
    {
      "start": 9.2,
      "end": 10.4,
      "text": "最后却发现"
    },
    {
      "start": 10.4,
      "end": 12.0,
      "text": "这本真心被她辜负"
    },
    {
      "start": 12.0,
      "end": 13.6,
      "text": "于是你自然而然"
    },
    {
      "start": 13.6,
      "end": 15.2,
      "text": "把她当成需要防备的人"
    },
    {
      "start": 15.2,
      "end": 16.6,
      "text": "这不是你小题大作"
    },
    {
      "start": 16.6,
      "end": 19.2,
      "text": "而是信任崩塌后的本能反应"
    },
    {
      "start": 19.2,
      "end": 20.6,
      "text": "也是她破坏信任"
    },
    {
      "start": 20.6,
      "end": 22.0,
      "text": "必须承担的代价"
    },
    {
      "start": 22.0,
      "end": 23.2,
      "text": "从心理学上来说"
    },
    {
      "start": 23.2,
      "end": 24.2,
      "text": "失去信任"
    },
    {
      "start": 24.2,
      "end": 26.8,
      "text": "本质就是失去了对这段感情的确定性"
    },
    {
      "start": 26.8,
      "end": 29.0,
      "text": "原本悉松平常的日常小事"
    },
    {
      "start": 29.0,
      "end": 31.2,
      "text": "在你眼里都暗藏风险"
    },
    {
      "start": 31.2,
      "end": 33.6,
      "text": "哪怕只是一次微不足道的负面细节"
    },
    {
      "start": 33.6,
      "end": 35.0,
      "text": "都会被你敏锐捕捉"
    },
    {
      "start": 35.0,
      "end": 36.6,
      "text": "在心底无限放大"
    },
    {
      "start": 36.6,
      "end": 39.0,
      "text": "当一个人总觉得自己身处不安之中"
    },
    {
      "start": 39.0,
      "end": 41.8,
      "text": "就会控制不住脑补各种糟糕的情节"
    },
    {
      "start": 41.8,
      "end": 43.4,
      "text": "想象力有多丰富"
    },
    {
      "start": 43.4,
      "end": 46.4,
      "text": "脑补带来的内耗和伤害就多深"
    },
    {
      "start": 46.4,
      "end": 48.2,
      "text": "很多时候困住这段关系的"
    },
    {
      "start": 48.2,
      "end": 49.8,
      "text": "早已不是事件本身"
    },
    {
      "start": 49.8,
      "end": 51.6,
      "text": "而是人对这件事的解读"
    },
    {
      "start": 51.6,
      "end": 54.2,
      "text": "一旦你心里认定对方还会伤害你"
    },
    {
      "start": 54.2,
      "end": 56.8,
      "text": "低落的情绪会瞬间席卷而来"
    },
    {
      "start": 56.8,
      "end": 58.6,
      "text": "就算当下什么都没有发生"
    },
    {
      "start": 58.6,
      "end": 60.8,
      "text": "这份负面感受也真实存在"
    },
    {
      "start": 60.8,
      "end": 63.4,
      "text": "负面情绪一定会催生负面行为"
    },
    {
      "start": 63.4,
      "end": 64.4,
      "text": "反复争吵"
    },
    {
      "start": 64.4,
      "end": 65.2,
      "text": "刻意冷战"
    },
    {
      "start": 65.2,
      "end": 66.6,
      "text": "甚至互相辞伤"
    },
    {
      "start": 66.6,
      "end": 68.6,
      "text": "一段被过错几岁信任的婚姻"
    },
    {
      "start": 68.6,
      "end": 69.6,
      "text": "等于给受伤的一方"
    },
    {
      "start": 69.6,
      "end": 71.6,
      "text": "无数个往坏处踩车的理由"
    },
    {
      "start": 71.6,
      "end": 73.8,
      "text": "逼得你时刻进崩 警惕"
    },
    {
      "start": 73.8,
      "end": 75.6,
      "text": "可长期处在这种状态里"
    },
    {
      "start": 75.6,
      "end": 77.8,
      "text": "谦恶的人同样是你自己"
    },
    {
      "start": 77.8,
      "end": 78.8,
      "text": "你不停追问"
    },
    {
      "start": 78.8,
      "end": 80.0,
      "text": "反复确认"
    },
    {
      "start": 80.0,
      "end": 82.2,
      "text": "本质上只是渴望达到安心的信号"
    },
    {
      "start": 82.2,
      "end": 84.8,
      "text": "想要确认这段感情还能走下去"
    },
    {
      "start": 84.8,
      "end": 86.8,
      "text": "想要回到从简安稳的生活"
    },
    {
      "start": 86.8,
      "end": 88.2,
      "text": "你盯着犯错的伴侣"
    },
    {
      "start": 88.2,
      "end": 89.5,
      "text": "一次次所要道歉"
    },
    {
      "start": 89.5,
      "end": 90.8,
      "text": "所要承诺"
    },
    {
      "start": 90.8,
      "end": 92.0,
      "text": "不是刻意为难"
    },
    {
      "start": 92.0,
      "end": 93.5,
      "text": "而是拼尽全力"
    },
    {
      "start": 93.5,
      "end": 95.3,
      "text": "想要找回丢失的安全感"
    },
    {
      "start": 95.3,
      "end": 97.2,
      "text": "试着修补破碎的信任"
    },
    {
      "start": 97.2,
      "end": 99.3,
      "text": "如果两个人都还想守住这段婚姻"
    },
    {
      "start": 99.3,
      "end": 101.3,
      "text": "不想多年感情彻底瓦解"
    },
    {
      "start": 101.3,
      "end": 102.3,
      "text": "这条路再难"
    },
    {
      "start": 102.3,
      "end": 103.8,
      "text": "也需要两个人一起努力"
    },
    {
      "start": 103.8,
      "end": 104.9,
      "text": "重建信任"
    },
    {
      "start": 104.9,
      "end": 106.4,
      "text": "对于信任破碎的夫妻"
    },
    {
      "start": 106.4,
      "end": 108.2,
      "text": "李安一直认同一个原则"
    },
    {
      "start": 108.2,
      "end": 109.9,
      "text": "谁破坏谁修复"
    },
    {
      "start": 109.9,
      "end": 112.3,
      "text": "是她亲手摧毁了彼此的信任"
    },
    {
      "start": 112.3,
      "end": 114.6,
      "text": "就理应由她扛起修复的责任"
    },
    {
      "start": 114.6,
      "end": 115.7,
      "text": "作为过错方"
    },
    {
      "start": 115.7,
      "end": 117.5,
      "text": "首先要拿出始足的诚意"
    },
    {
      "start": 117.5,
      "end": 118.8,
      "text": "错了就是错了"
    },
    {
      "start": 118.8,
      "end": 120.6,
      "text": "没有任何借口可以该多"
    },
    {
      "start": 120.6,
      "end": 122.6,
      "text": "可以试图成书当时的处境"
    },
    {
      "start": 122.6,
      "end": 124.2,
      "text": "但绝对不能推卸责任"
    },
    {
      "start": 124.2,
      "end": 125.2,
      "text": "躲闪逃避"
    },
    {
      "start": 125.2,
      "end": 126.3,
      "text": "含糊敷衍"
    },
    {
      "start": 126.3,
      "end": 127.7,
      "text": "弯弯整整认错"
    },
    {
      "start": 127.7,
      "end": 129.1,
      "text": "踏踏实实改正"
    },
    {
      "start": 129.1,
      "end": 130.0,
      "text": "这是修复信任"
    },
    {
      "start": 130.0,
      "end": 131.9,
      "text": "重建亲密关系的第一步"
    },
    {
      "start": 131.9,
      "end": 133.3,
      "text": "也是最关键的一步"
    },
    {
      "start": 133.3,
      "end": 134.4,
      "text": "往后的日子里"
    },
    {
      "start": 134.4,
      "end": 135.5,
      "text": "你难免猜疑"
    },
    {
      "start": 135.5,
      "end": 136.8,
      "text": "情绪起伏不定"
    },
    {
      "start": 136.8,
      "end": 138.2,
      "text": "上一秒伤起瓶颈"
    },
    {
      "start": 138.2,
      "end": 140.0,
      "text": "下一秒就会因为一件小事"
    },
    {
      "start": 140.0,
      "end": 141.1,
      "text": "崩溃爆发"
    },
    {
      "start": 141.1,
      "end": 143.2,
      "text": "这些都是受伤之后的正常反应"
    },
    {
      "start": 143.2,
      "end": 144.8,
      "text": "她需要拿出足够的耐心"
    },
    {
      "start": 144.8,
      "end": 145.9,
      "text": "接纳你的情绪"
    },
    {
      "start": 145.9,
      "end": 147.4,
      "text": "尽力安抚你的不安"
    },
    {
      "start": 147.4,
      "end": 148.8,
      "text": "陪着你慢慢平复"
    },
    {
      "start": 148.8,
      "end": 149.9,
      "text": "调整心态"
    },
    {
      "start": 149.9,
      "end": 151.0,
      "text": "修复其理"
    },
    {
      "start": 151.0,
      "end": 152.7,
      "text": "过错方或许要放下一部分"
    },
    {
      "start": 152.7,
      "end": 154.0,
      "text": "所谓的自由和体面"
    },
    {
      "start": 154.0,
      "end": 155.9,
      "text": "坦然接受你的合理监督"
    },
    {
      "start": 155.9,
      "end": 157.6,
      "text": "主动分享日常和想法"
    },
    {
      "start": 157.6,
      "end": 158.9,
      "text": "愿意同步行踪"
    },
    {
      "start": 158.9,
      "end": 160.6,
      "text": "收知情况主动报备"
    },
    {
      "start": 160.6,
      "end": 162.2,
      "text": "用一张桩看得见的行动"
    },
    {
      "start": 162.2,
      "end": 163.6,
      "text": "慢慢撫平你的不安"
    },
    {
      "start": 163.6,
      "end": 165.3,
      "text": "一点点攒回你的信任"
    },
    {
      "start": 165.3,
      "end": 167.1,
      "text": "也可以多安排一些共同活动"
    },
    {
      "start": 167.1,
      "end": 168.2,
      "text": "一起短途出行"
    },
    {
      "start": 168.2,
      "end": 169.5,
      "text": "看一场喜欢的电影"
    },
    {
      "start": 169.5,
      "end": 171.3,
      "text": "或是约熟悉的好友小剧"
    },
    {
      "start": 171.3,
      "end": 172.8,
      "text": "两个人长时间独处"
    },
    {
      "start": 172.8,
      "end": 175.4,
      "text": "很容易反复沉溺在过往的负面回忆里"
    },
    {
      "start": 175.4,
      "end": 177.1,
      "text": "一同向外感受生活"
    },
    {
      "start": 177.1,
      "end": 179.3,
      "text": "更容易找回我们是一体的归属感"
    },
    {
      "start": 179.3,
      "end": 181.0,
      "text": "慢慢拉近彼此的距离"
    },
    {
      "start": 181.0,
      "end": 182.2,
      "text": "加固信任感"
    },
    {
      "start": 182.2,
      "end": 183.0,
      "text": "以上"
    },
    {
      "start": 183.0,
      "end": 185.0,
      "text": "是过错方需要付出的努力"
    },
    {
      "start": 185.0,
      "end": 186.0,
      "text": "而受伤的一方"
    },
    {
      "start": 186.0,
      "end": 188.2,
      "text": "也不能一直困在受害者心态里"
    },
    {
      "start": 188.2,
      "end": 190.1,
      "text": "陷入无休止的被害妄想"
    },
    {
      "start": 190.1,
      "end": 193.0,
      "text": "你要学着看见对方实实在在的改变"
    },
    {
      "start": 193.0,
      "end": 194.2,
      "text": "她主动早归"
    },
    {
      "start": 194.2,
      "end": 195.7,
      "text": "主动留意你的情绪"
    },
    {
      "start": 195.7,
      "end": 197.4,
      "text": "愿意敞开心肺沟通"
    },
    {
      "start": 197.4,
      "end": 199.9,
      "text": "这些都是她想要修复关系的信号"
    },
    {
      "start": 199.9,
      "end": 201.9,
      "text": "是这理性看待当下的相处"
    },
    {
      "start": 202.0,
      "end": 203.7,
      "text": "请那往正向的方向思考"
    },
    {
      "start": 203.7,
      "end": 206.7,
      "text": "不要放任自己沉溺在极端负面的情绪里"
    },
    {
      "start": 206.7,
      "end": 209.2,
      "text": "更不要抱着报复的心态对待对方"
    },
    {
      "start": 209.2,
      "end": 210.6,
      "text": "事情刚爆发的时候"
    },
    {
      "start": 210.6,
      "end": 211.9,
      "text": "想要宣泄情绪"
    },
    {
      "start": 211.9,
      "end": 213.1,
      "text": "是人之常情"
    },
    {
      "start": 213.1,
      "end": 214.1,
      "text": "但你要记得"
    },
    {
      "start": 214.1,
      "end": 215.7,
      "text": "你的目标是修复婚姻"
    },
    {
      "start": 215.7,
      "end": 217.6,
      "text": "不是彻底摧毁这段关系"
    },
    {
      "start": 217.6,
      "end": 218.9,
      "text": "如果缺少你的配合"
    },
    {
      "start": 218.9,
      "end": 220.3,
      "text": "单凭她一个人的努力"
    },
    {
      "start": 220.3,
      "end": 221.9,
      "text": "信任根本无法重建"
    },
    {
      "start": 221.9,
      "end": 223.9,
      "text": "但她主动是这修复关系时"
    },
    {
      "start": 223.9,
      "end": 225.6,
      "text": "至少不要刻意去破坏"
    },
    {
      "start": 225.6,
      "end": 226.5,
      "text": "感心里"
    },
    {
      "start": 226.5,
      "end": 229.0,
      "text": "绝对的信任和绝对的补信任"
    },
    {
      "start": 229.0,
      "end": 230.4,
      "text": "都暗藏隐患"
    },
    {
      "start": 230.4,
      "end": 232.1,
      "text": "保无保留的全然信任"
    },
    {
      "start": 232.1,
      "end": 233.9,
      "text": "会让人丧失风险意识"
    },
    {
      "start": 233.9,
      "end": 235.8,
      "text": "忽略感情里潜藏的问题"
    },
    {
      "start": 235.8,
      "end": 237.7,
      "text": "而无休止的猜忌怀疑"
    },
    {
      "start": 237.7,
      "end": 239.0,
      "text": "会让你长久困在"
    },
    {
      "start": 239.0,
      "end": 240.2,
      "text": "焦虑痛苦里"
    },
    {
      "start": 240.2,
      "end": 242.4,
      "text": "慢慢耗尽两个人所有的情谊"
    },
    {
      "start": 242.4,
      "end": 244.2,
      "text": "李安认为更好的状态是"
    },
    {
      "start": 244.2,
      "end": 245.6,
      "text": "保持适度警觉"
    },
    {
      "start": 245.6,
      "end": 247.3,
      "text": "清楚婚姻存在风险"
    },
    {
      "start": 247.3,
      "end": 248.6,
      "text": "白张自己的心态"
    },
    {
      "start": 248.6,
      "end": 249.8,
      "text": "做好心理愿"
    },
    {
      "start": 249.8,
      "end": 251.8,
      "text": "这份惊醒才是对家庭"
    },
    {
      "start": 251.8,
      "end": 253.1,
      "text": "对这段关系负责"
    },
    {
      "start": 253.1,
      "end": 254.3,
      "text": "但理性的警觉"
    },
    {
      "start": 254.3,
      "end": 255.8,
      "text": "和草木皆病的多疑"
    },
    {
      "start": 255.8,
      "end": 257.1,
      "text": "完全是两回事"
    },
    {
      "start": 257.1,
      "end": 259.0,
      "text": "很多人习惯性补风捉影"
    },
    {
      "start": 259.0,
      "end": 260.6,
      "text": "对方和异性正常相处"
    },
    {
      "start": 260.6,
      "end": 262.2,
      "text": "就断定关系越界"
    },
    {
      "start": 262.2,
      "end": 263.3,
      "text": "一同吃顿饭"
    },
    {
      "start": 263.3,
      "end": 264.8,
      "text": "就认定救错崇业"
    },
    {
      "start": 264.8,
      "end": 266.1,
      "text": "这种过度多疑"
    },
    {
      "start": 266.1,
      "end": 267.9,
      "text": "大多元于内心的自卑"
    },
    {
      "start": 267.9,
      "end": 269.1,
      "text": "不够认可自己"
    },
    {
      "start": 269.1,
      "end": 270.5,
      "text": "就很难信任别人"
    },
    {
      "start": 270.5,
      "end": 271.3,
      "text": "潜意识里"
    },
    {
      "start": 271.3,
      "end": 273.0,
      "text": "会觉得自己留不住对方"
    },
    {
      "start": 273.0,
      "end": 273.8,
      "text": "提前预设"
    },
    {
      "start": 273.8,
      "end": 275.6,
      "text": "他会向外寻求未解"
    },
    {
      "start": 275.6,
      "end": 276.9,
      "text": "如果你是这样的性格"
    },
    {
      "start": 276.9,
      "end": 278.2,
      "text": "一定要提醒自己"
    },
    {
      "start": 278.2,
      "end": 279.9,
      "text": "不要困在主观想象里"
    },
    {
      "start": 279.9,
      "end": 281.5,
      "text": "婚姻确实出过裂痕"
    },
    {
      "start": 281.5,
      "end": 283.2,
      "text": "但未必会持续恶化"
    },
    {
      "start": 283.2,
      "end": 284.4,
      "text": "无端的猜忌"
    },
    {
      "start": 284.4,
      "end": 286.4,
      "text": "只会不断给婚姻设置阻碍"
    },
    {
      "start": 286.4,
      "end": 287.9,
      "text": "一点点把对方推远"
    },
    {
      "start": 287.9,
      "end": 290.3,
      "text": "不过你的伴侣属于敏感多疑的性格"
    },
    {
      "start": 290.3,
      "end": 292.7,
      "text": "那你形式就要尽量谈当透明"
    },
    {
      "start": 292.7,
      "end": 294.4,
      "text": "主动释放安心信号"
    },
    {
      "start": 294.4,
      "end": 295.4,
      "text": "多肯定他"
    },
    {
      "start": 295.4,
      "end": 296.3,
      "text": "赞美他"
    },
    {
      "start": 296.3,
      "end": 297.8,
      "text": "让他感受到你对他"
    },
    {
      "start": 297.8,
      "end": 299.2,
      "text": "对这个家的满足"
    },
    {
      "start": 299.2,
      "end": 300.4,
      "text": "帮他建立底气"
    },
    {
      "start": 300.4,
      "end": 302.0,
      "text": "他才能慢慢放下猜忌"
    },
    {
      "start": 302.0,
      "end": 303.0,
      "text": "学着信任"
    },
    {
      "start": 303.0,
      "end": 305.3,
      "text": "人天生对伴侣有情感独占于"
    },
    {
      "start": 305.3,
      "end": 307.0,
      "text": "加上长久的观念影响"
    },
    {
      "start": 307.0,
      "end": 309.4,
      "text": "我们都会本能期待另一半忠诚"
    },
    {
      "start": 309.4,
      "end": 311.0,
      "text": "在安全感之间事上"
    },
    {
      "start": 311.0,
      "end": 312.4,
      "text": "男女皆是如此"
    },
    {
      "start": 312.4,
      "end": 313.3,
      "text": "没有信任"
    },
    {
      "start": 313.3,
      "end": 315.0,
      "text": "就没有真正的安全感"
    },
    {
      "start": 315.0,
      "end": 316.3,
      "text": "和睦的亲密关系"
    },
    {
      "start": 316.3,
      "end": 317.6,
      "text": "也就无从谈起"
    },
    {
      "start": 317.6,
      "end": 318.3,
      "text": "老话讲"
    },
    {
      "start": 318.3,
      "end": 319.7,
      "text": "家和万事心"
    },
    {
      "start": 319.7,
      "end": 321.1,
      "text": "夫妻之间猜忌不断"
    },
    {
      "start": 321.1,
      "end": 322.2,
      "text": "争执不休"
    },
    {
      "start": 322.2,
      "end": 324.6,
      "text": "人很难把精力投入工作和生活"
    },
    {
      "start": 324.6,
      "end": 326.4,
      "text": "更谈不上家庭幸福"
    },
    {
      "start": 326.4,
      "end": 328.4,
      "text": "信任就像婚姻里的空气"
    },
    {
      "start": 328.4,
      "end": 330.3,
      "text": "拥有的时候常常被忽略"
    },
    {
      "start": 330.3,
      "end": 331.2,
      "text": "一旦消失"
    },
    {
      "start": 331.2,
      "end": 332.5,
      "text": "只会让人窒息"
    },
    {
      "start": 332.5,
      "end": 333.8,
      "text": "没有信任的婚姻"
    },
    {
      "start": 333.8,
      "end": 335.4,
      "text": "如同没有地基的房子"
    },
    {
      "start": 335.4,
      "end": 336.4,
      "text": "摇摇欲坠"
    },
    {
      "start": 336.4,
      "end": 338.1,
      "text": "幸福更是无从说起"
    },
    {
      "start": 338.1,
      "end": 339.4,
      "text": "最后李安想说"
    },
    {
      "start": 339.4,
      "end": 341.0,
      "text": "婚姻遭遇信任危机"
    },
    {
      "start": 341.0,
      "end": 341.9,
      "text": "换个角度看"
    },
    {
      "start": 341.9,
      "end": 343.6,
      "text": "也是感情重塑的契机"
    },
    {
      "start": 343.6,
      "end": 345.7,
      "text": "只要两个人都愿意坚持往前走"
    },
    {
      "start": 345.7,
      "end": 347.3,
      "text": "度过难关之后的感情"
    },
    {
      "start": 347.3,
      "end": 349.5,
      "text": "通往会比从前更加稳固"
    },
    {
      "start": 349.5,
      "end": 350.5,
      "text": "至上痛苦"
    },
    {
      "start": 350.5,
      "end": 352.3,
      "text": "会催生两个人改变的决心"
    },
    {
      "start": 352.3,
      "end": 353.6,
      "text": "也让你们看清婚姻里"
    },
    {
      "start": 353.6,
      "end": 355.0,
      "text": "原本藏着的问题"
    },
    {
      "start": 355.0,
      "end": 356.5,
      "text": "倘若能够走出伤痛"
    },
    {
      "start": 356.5,
      "end": 357.7,
      "text": "化解隔阔"
    },
    {
      "start": 357.7,
      "end": 359.4,
      "text": "重新建立爱的连结"
    },
    {
      "start": 359.4,
      "end": 360.5,
      "text": "这份感情"
    },
    {
      "start": 360.5,
      "end": 362.5,
      "text": "会向韭汉逢甘陵的草木"
    },
    {
      "start": 362.5,
      "end": 363.6,
      "text": "完成褪变"
    },
    {
      "start": 363.6,
      "end": 365.0,
      "text": "变得牢不可破"
    },
    {
      "start": 365.0,
      "end": 367.0,
      "text": "李安向来劝何不劝离"
    },
    {
      "start": 367.0,
      "end": 368.5,
      "text": "婚姻感情里"
    },
    {
      "start": 368.5,
      "end": 370.3,
      "text": "无论遇上什么样的困惑"
    },
    {
      "start": 370.3,
      "end": 372.1,
      "text": "都可以来找李安聊聊"
    },
    {
      "start": 372.1,
      "end": 374.1,
      "text": "李安愿意认真听你的故事"
    },
    {
      "start": 374.1,
      "end": 375.3,
      "text": "陪你梳理出路"
    },
    {
      "start": 375.3,
      "end": 377.3,
      "text": "给你温暖的陪伴和坚定的支撑"
    }
  ]
}