[
 {
  "start": 0.0,
  "end": 1.72,
  "text": "夫妻接纳了犯错的伴侣"
 },
 {
  "start": 1.72,
  "end": 3.32,
  "text": "却始终放不下怀疑"
 },
 {
  "start": 3.32,
  "end": 4.88,
  "text": "最智慧的做法是什么"
 },
 {
  "start": 4.88,
  "end": 7.16,
  "text": "曾经你笃定她是好人"
 },
 {
  "start": 7.16,
  "end": 9.08,
  "text": "毫无保留交出真心"
 },
 {
  "start": 9.08,
  "end": 10.32,
  "text": "最后却发现"
 },
 {
  "start": 10.32,
  "end": 12.0,
  "text": "这份真心被她辜负"
 },
 {
  "start": 12.0,
  "end": 13.48,
  "text": "于是你自然而然"
 },
 {
  "start": 13.48,
  "end": 15.16,
  "text": "把她当成需要防备的人"
 },
 {
  "start": 15.16,
  "end": 16.56,
  "text": "这不是你小题大做"
 },
 {
  "start": 16.56,
  "end": 19.04,
  "text": "而是信任崩塌后的本能反应"
 },
 {
  "start": 19.04,
  "end": 20.48,
  "text": "也是她破坏信任"
 },
 {
  "start": 20.48,
  "end": 21.88,
  "text": "必须承担的代价"
 },
 {
  "start": 21.88,
  "end": 23.2,
  "text": "从心理学上来说"
 },
 {
  "start": 23.2,
  "end": 24.16,
  "text": "失去信任"
 },
 {
  "start": 24.16,
  "end": 26.76,
  "text": "本质就是失去了对这段感情的确定性"
 },
 {
  "start": 26.76,
  "end": 28.96,
  "text": "原本稀松平常的日常小事"
 },
 {
  "start": 29.08,
  "end": 30.0,
  "text": "在你眼里"
 },
 {
  "start": 30.0,
  "end": 31.28,
  "text": "都暗藏风险"
 },
 {
  "start": 31.28,
  "end": 33.64,
  "text": "哪怕只是一次微不足道的负面细节"
 },
 {
  "start": 33.64,
  "end": 35.08,
  "text": "都会被你敏锐捕捉"
 },
 {
  "start": 35.08,
  "end": 36.6,
  "text": "在心底无限放大"
 },
 {
  "start": 36.6,
  "end": 38.96,
  "text": "当一个人总觉得自己身处不安之中"
 },
 {
  "start": 38.96,
  "end": 41.76,
  "text": "就会控制不住脑补各种糟糕的情节"
 },
 {
  "start": 41.76,
  "end": 43.52,
  "text": "想象力有多丰富"
 },
 {
  "start": 43.52,
  "end": 46.44,
  "text": "脑补带来的内耗和伤害就有多深"
 },
 {
  "start": 46.44,
  "end": 48.16,
  "text": "很多时候困住这段关系的"
 },
 {
  "start": 48.16,
  "end": 49.76,
  "text": "早已不是事件本身"
 },
 {
  "start": 49.76,
  "end": 51.6,
  "text": "而是人对这件事的解读"
 },
 {
  "start": 51.6,
  "end": 54.24,
  "text": "一旦你心里认定对方还会伤害你"
 },
 {
  "start": 54.24,
  "end": 56.76,
  "text": "低落的情绪会瞬间席卷而来"
 },
 {
  "start": 56.76,
  "end": 58.68,
  "text": "就算当下什么都没有发生"
 },
 {
  "start": 58.68,
  "end": 60.92,
  "text": "这份负面感受也真实存在"
 },
 {
  "start": 60.92,
  "end": 63.44,
  "text": "负面情绪一定会催生负面行为"
 },
 {
  "start": 63.44,
  "end": 64.4,
  "text": "反复争吵"
 },
 {
  "start": 64.4,
  "end": 65.32,
  "text": "刻意冷战"
 },
 {
  "start": 65.32,
  "end": 66.6,
  "text": "甚至互相刺伤"
 },
 {
  "start": 66.6,
  "end": 68.6,
  "text": "一段被过错击碎信任的婚姻"
 },
 {
  "start": 68.6,
  "end": 69.68,
  "text": "等于给受伤的一方"
 },
 {
  "start": 69.68,
  "end": 71.6,
  "text": "无数个草木皆兵的理由"
 },
 {
  "start": 71.6,
  "end": 72.96,
  "text": "逼得你时刻紧绷"
 },
 {
  "start": 72.96,
  "end": 73.76,
  "text": "警惕"
 },
 {
  "start": 73.76,
  "end": 75.6,
  "text": "可长期处在这种状态里"
 },
 {
  "start": 75.6,
  "end": 77.76,
  "text": "煎熬的人同样是你自己"
 },
 {
  "start": 77.76,
  "end": 78.84,
  "text": "你不停追问"
 },
 {
  "start": 78.84,
  "end": 80.04,
  "text": "反复确认"
 },
 {
  "start": 80.04,
  "end": 82.32,
  "text": "本质上只是渴望得到一个安心的信号"
 },
 {
  "start": 82.32,
  "end": 84.8,
  "text": "想要确认这段感情还能走下去"
 },
 {
  "start": 84.8,
  "end": 86.84,
  "text": "想要回到从前安稳的生活"
 },
 {
  "start": 86.84,
  "end": 88.24,
  "text": "你盯着犯错的伴侣"
 },
 {
  "start": 88.24,
  "end": 89.56,
  "text": "一次次索要道歉"
 },
 {
  "start": 89.56,
  "end": 90.84,
  "text": "索要承诺"
 },
 {
  "start": 90.84,
  "end": 92.04,
  "text": "不是刻意为难"
 },
 {
  "start": 92.04,
  "end": 93.52,
  "text": "而是拼尽全力"
 },
 {
  "start": 93.52,
  "end": 95.36,
  "text": "想要找回丢失的安全感"
 },
 {
  "start": 95.36,
  "end": 97.2,
  "text": "试着修补破碎的信任"
 },
 {
  "start": 97.2,
  "end": 99.32,
  "text": "如果两个人都还想守住这段婚姻"
 },
 {
  "start": 99.32,
  "end": 101.32,
  "text": "不想多年感情彻底瓦解"
 },
 {
  "start": 101.32,
  "end": 102.32,
  "text": "这条路再难"
 },
 {
  "start": 102.32,
  "end": 104.92,
  "text": "也需要两个人一起努力重建信任"
 },
 {
  "start": 104.92,
  "end": 106.44,
  "text": "对于信任破碎的夫妻"
 },
 {
  "start": 106.44,
  "end": 108.2,
  "text": "李安一直认同一个原则"
 },
 {
  "start": 108.2,
  "end": 109.92,
  "text": "谁破坏谁修复"
 },
 {
  "start": 109.92,
  "end": 112.32,
  "text": "是她亲手摧毁了彼此的信任"
 },
 {
  "start": 112.32,
  "end": 114.64,
  "text": "就理应由她扛起修复的责任"
 },
 {
  "start": 114.64,
  "end": 115.68,
  "text": "作为过错方"
 },
 {
  "start": 115.68,
  "end": 117.52,
  "text": "首先要拿出十足的诚意"
 },
 {
  "start": 117.52,
  "end": 118.76,
  "text": "错了就是错了"
 },
 {
  "start": 118.76,
  "end": 120.6,
  "text": "没有任何借口可以推脱"
 },
 {
  "start": 120.6,
  "end": 122.56,
  "text": "可以试图陈述当时的处境"
 },
 {
  "start": 122.56,
  "end": 124.16,
  "text": "但绝对不能推卸责任"
 },
 {
  "start": 124.16,
  "end": 125.16,
  "text": "躲闪逃避"
 },
 {
  "start": 125.16,
  "end": 126.32,
  "text": "含糊敷衍"
 },
 {
  "start": 126.32,
  "end": 127.68,
  "text": "坦坦荡荡认错"
 },
 {
  "start": 127.68,
  "end": 129.04,
  "text": "踏踏实实改正"
 },
 {
  "start": 129.04,
  "end": 130.0,
  "text": "这是修复信任"
 },
 {
  "start": 130.0,
  "end": 131.88,
  "text": "重建亲密关系的第一步"
 },
 {
  "start": 131.88,
  "end": 133.28,
  "text": "也是最关键的一步"
 },
 {
  "start": 133.28,
  "end": 134.4,
  "text": "往后的日子里"
 },
 {
  "start": 134.4,
  "end": 135.48,
  "text": "你难免猜疑"
 },
 {
  "start": 135.48,
  "end": 136.8,
  "text": "情绪起伏不定"
 },
 {
  "start": 136.8,
  "end": 138.2,
  "text": "上一秒伤春悲秋"
 },
 {
  "start": 138.2,
  "end": 140.0,
  "text": "下一秒就会因为一件小事"
 },
 {
  "start": 140.0,
  "end": 141.04,
  "text": "崩溃爆发"
 },
 {
  "start": 141.04,
  "end": 143.2,
  "text": "这些都是受伤之后的正常反应"
 },
 {
  "start": 143.2,
  "end": 144.76,
  "text": "她需要拿出足够的耐心"
 },
 {
  "start": 144.76,
  "end": 145.92,
  "text": "接纳你的情绪"
 },
 {
  "start": 145.92,
  "end": 147.44,
  "text": "尽力安抚你的不安"
 },
 {
  "start": 147.44,
  "end": 148.84,
  "text": "陪着你慢慢平复"
 },
 {
  "start": 148.84,
  "end": 149.92,
  "text": "调整心态"
 },
 {
  "start": 149.92,
  "end": 151.0,
  "text": "修复信任"
 },
 {
  "start": 151.0,
  "end": 152.72,
  "text": "过错方或许要放下一部分"
 },
 {
  "start": 152.72,
  "end": 154.04,
  "text": "所谓的自由和体面"
 },
 {
  "start": 154.04,
  "end": 155.88,
  "text": "坦然接受你的合理监督"
 },
 {
  "start": 155.88,
  "end": 157.6,
  "text": "主动分享日常和想法"
 },
 {
  "start": 157.6,
  "end": 158.88,
  "text": "愿意同步行踪"
 },
 {
  "start": 158.88,
  "end": 160.56,
  "text": "有事主动报备"
 },
 {
  "start": 160.56,
  "end": 162.24,
  "text": "用看得见的行动"
 },
 {
  "start": 162.24,
  "end": 163.6,
  "text": "慢慢抚平你的不安"
 },
 {
  "start": 163.6,
  "end": 165.36,
  "text": "一点点攒回你的信任"
 },
 {
  "start": 165.36,
  "end": 167.08,
  "text": "也可以多安排一些共同活动"
 },
 {
  "start": 167.08,
  "end": 168.2,
  "text": "一起短途出行"
 },
 {
  "start": 168.2,
  "end": 169.56,
  "text": "看一场喜欢的电影"
 },
 {
  "start": 169.56,
  "end": 171.28,
  "text": "或是约熟悉的好友小聚"
 },
 {
  "start": 171.28,
  "end": 172.8,
  "text": "两个人长时间独处"
 },
 {
  "start": 172.84,
  "end": 174.36,
  "text": "很容易反复沉溺在过往的"
 },
 {
  "start": 174.36,
  "end": 175.48,
  "text": "负面回忆里"
 },
 {
  "start": 175.48,
  "end": 177.2,
  "text": "一同向外感受生活"
 },
 {
  "start": 177.2,
  "end": 178.6,
  "text": "更容易找回我们是一体的"
 },
 {
  "start": 178.6,
  "end": 179.4,
  "text": "归属感"
 },
 {
  "start": 179.4,
  "end": 181.12,
  "text": "慢慢拉近彼此的距离"
 },
 {
  "start": 181.12,
  "end": 182.28,
  "text": "加固信任感"
 },
 {
  "start": 182.28,
  "end": 183.04,
  "text": "以上"
 },
 {
  "start": 183.04,
  "end": 185.04,
  "text": "是过错方需要付出的努力"
 },
 {
  "start": 185.04,
  "end": 186.08,
  "text": "而受伤的一方"
 },
 {
  "start": 186.08,
  "end": 188.24,
  "text": "也不能一直困在受害者心态里"
 },
 {
  "start": 188.24,
  "end": 190.2,
  "text": "陷入无休止的被害妄想"
 },
 {
  "start": 190.2,
  "end": 191.36,
  "text": "你要学着看见对方"
 },
 {
  "start": 191.36,
  "end": 193.04,
  "text": "实实在在的改变"
 },
 {
  "start": 193.04,
  "end": 194.24,
  "text": "她主动早归"
 },
 {
  "start": 194.24,
  "end": 195.76,
  "text": "主动留意你的情绪"
 },
 {
  "start": 195.76,
  "end": 197.48,
  "text": "愿意敞开心扉沟通"
 },
 {
  "start": 197.48,
  "end": 199.92,
  "text": "这些都是她想要修复关系的信号"
 },
 {
  "start": 199.92,
  "end": 201.96,
  "text": "试着理性看待当下的相处"
 },
 {
  "start": 201.96,
  "end": 203.68,
  "text": "多往正向的方向思考"
 },
 {
  "start": 203.68,
  "end": 206.64,
  "text": "不要放任自己沉溺在极端负面的情绪里"
 },
 {
  "start": 206.64,
  "end": 209.16,
  "text": "更不要抱着报复的心态对待对方"
 },
 {
  "start": 209.16,
  "end": 210.56,
  "text": "事情刚爆发的时候"
 },
 {
  "start": 210.56,
  "end": 211.84,
  "text": "想要宣泄情绪"
 },
 {
  "start": 211.84,
  "end": 213.04,
  "text": "是人之常情"
 },
 {
  "start": 213.04,
  "end": 214.04,
  "text": "但你要记得"
 },
 {
  "start": 214.04,
  "end": 215.68,
  "text": "你的目标是修复婚姻"
 },
 {
  "start": 215.68,
  "end": 217.52,
  "text": "不是彻底摧毁这段关系"
 },
 {
  "start": 217.52,
  "end": 218.84,
  "text": "如果缺少你的配合"
 },
 {
  "start": 218.84,
  "end": 220.24,
  "text": "单凭她一个人的努力"
 },
 {
  "start": 220.24,
  "end": 221.84,
  "text": "信任根本无法重建"
 },
 {
  "start": 221.84,
  "end": 223.8,
  "text": "但她主动试着修补关系时"
 },
 {
  "start": 223.8,
  "end": 225.52,
  "text": "至少不要刻意去破坏"
 },
 {
  "start": 225.52,
  "end": 226.48,
  "text": "在心理上"
 },
 {
  "start": 226.48,
  "end": 228.96,
  "text": "绝对的信任和绝对的不信任"
 },
 {
  "start": 228.96,
  "end": 230.28,
  "text": "都暗藏隐患"
 },
 {
  "start": 230.28,
  "end": 231.92,
  "text": "毫无保留的全然信任"
 },
 {
  "start": 232.04,
  "end": 233.72,
  "text": "会让人丧失风险意识"
 },
 {
  "start": 233.72,
  "end": 235.64,
  "text": "忽略感情里潜藏的问题"
 },
 {
  "start": 235.64,
  "end": 237.52,
  "text": "而无休止的猜忌怀疑"
 },
 {
  "start": 237.52,
  "end": 238.88,
  "text": "会让你长久困在"
 },
 {
  "start": 238.88,
  "end": 240.08,
  "text": "焦虑痛苦里"
 },
 {
  "start": 240.08,
  "end": 242.2,
  "text": "慢慢耗尽两个人所有的情谊"
 },
 {
  "start": 242.2,
  "end": 244.04,
  "text": "李安认为更好的状态是"
 },
 {
  "start": 244.04,
  "end": 245.44,
  "text": "保持适度警觉"
 },
 {
  "start": 245.44,
  "end": 247.12,
  "text": "清楚婚姻存在风险"
 },
 {
  "start": 247.12,
  "end": 248.4,
  "text": "摆正自己的心态"
 },
 {
  "start": 248.4,
  "end": 249.64,
  "text": "做好心理准备"
 },
 {
  "start": 249.64,
  "end": 251.6,
  "text": "这份警觉才是对家庭"
 },
 {
  "start": 251.6,
  "end": 252.92,
  "text": "对这段关系负责"
 },
 {
  "start": 252.92,
  "end": 255.6,
  "text": "但理性的警觉和草木皆兵的多疑"
 },
 {
  "start": 255.6,
  "end": 256.96,
  "text": "完全是两回事"
 },
 {
  "start": 256.96,
  "end": 258.8,
  "text": "很多人习惯性捕风捉影"
 },
 {
  "start": 258.8,
  "end": 260.44,
  "text": "对方和异性正常相处"
 },
 {
  "start": 260.44,
  "end": 261.92,
  "text": "就断定关系越界"
 },
 {
  "start": 261.92,
  "end": 263.04,
  "text": "一同吃顿饭"
 },
 {
  "start": 263.04,
  "end": 264.6,
  "text": "就认定旧情复燃"
 },
 {
  "start": 264.6,
  "end": 265.84,
  "text": "这种过度多疑"
 },
 {
  "start": 265.84,
  "end": 267.64,
  "text": "大多源于内心的自卑"
 },
 {
  "start": 267.64,
  "end": 268.8,
  "text": "不够认可自己"
 },
 {
  "start": 268.8,
  "end": 270.24,
  "text": "就很难信任别人"
 },
 {
  "start": 270.24,
  "end": 271.08,
  "text": "潜意识里"
 },
 {
  "start": 271.08,
  "end": 272.72,
  "text": "会觉得自己留不住对方"
 },
 {
  "start": 272.72,
  "end": 273.56,
  "text": "提前预设"
 },
 {
  "start": 273.56,
  "end": 275.32,
  "text": "他会向外寻求慰藉"
 },
 {
  "start": 275.32,
  "end": 276.64,
  "text": "如果你是这样的性格"
 },
 {
  "start": 276.64,
  "end": 277.92,
  "text": "一定要提醒自己"
 },
 {
  "start": 277.92,
  "end": 279.64,
  "text": "不要困在主观想象里"
 },
 {
  "start": 279.64,
  "end": 281.24,
  "text": "婚姻确实出过裂痕"
 },
 {
  "start": 281.24,
  "end": 282.96,
  "text": "但未必会持续恶化"
 },
 {
  "start": 282.96,
  "end": 284.12,
  "text": "无端的猜忌"
 },
 {
  "start": 284.12,
  "end": 286.08,
  "text": "只会不断给婚姻设置阻碍"
 },
 {
  "start": 286.08,
  "end": 287.68,
  "text": "一点点把对方推远"
 },
 {
  "start": 287.68,
  "end": 288.68,
  "text": "如果你的伴侣属于"
 },
 {
  "start": 288.68,
  "end": 290.2,
  "text": "敏感多疑的性格"
 },
 {
  "start": 290.28,
  "end": 292.6,
  "text": "那你的行动就要尽量坦荡透明"
 },
 {
  "start": 292.6,
  "end": 294.36,
  "text": "主动释放安心信号"
 },
 {
  "start": 294.36,
  "end": 296.24,
  "text": "多肯定他赞美他"
 },
 {
  "start": 296.24,
  "end": 297.68,
  "text": "让他感受到你对他"
 },
 {
  "start": 297.68,
  "end": 299.08,
  "text": "对这个家的满足"
 },
 {
  "start": 299.08,
  "end": 300.36,
  "text": "帮他建立底气"
 },
 {
  "start": 300.36,
  "end": 301.88,
  "text": "他才能慢慢放下猜忌"
 },
 {
  "start": 301.88,
  "end": 302.96,
  "text": "学着信任"
 },
 {
  "start": 302.96,
  "end": 305.16,
  "text": "人天生对伴侣有情感独占欲"
 },
 {
  "start": 305.16,
  "end": 306.92,
  "text": "加上长久的观念影响"
 },
 {
  "start": 306.92,
  "end": 309.28,
  "text": "我们都会本能期待另一半忠诚"
 },
 {
  "start": 309.28,
  "end": 310.92,
  "text": "在安全感这件事上"
 },
 {
  "start": 310.92,
  "end": 312.32,
  "text": "男女皆是如此"
 },
 {
  "start": 312.32,
  "end": 313.24,
  "text": "没有信任"
 },
 {
  "start": 313.24,
  "end": 314.88,
  "text": "就没有真正的安全感"
 },
 {
  "start": 314.88,
  "end": 316.24,
  "text": "和睦的亲密关系"
 },
 {
  "start": 316.24,
  "end": 317.48,
  "text": "也就无从谈起"
 },
 {
  "start": 317.48,
  "end": 318.24,
  "text": "老话讲"
 },
 {
  "start": 318.24,
  "end": 319.56,
  "text": "家和万事兴"
 },
 {
  "start": 319.6,
  "end": 321.0,
  "text": "夫妻之间猜忌不断"
 },
 {
  "start": 321.0,
  "end": 322.16,
  "text": "争执不休"
 },
 {
  "start": 322.16,
  "end": 324.56,
  "text": "人很难把精力投入工作和生活"
 },
 {
  "start": 324.56,
  "end": 326.32,
  "text": "更谈不上家庭幸福"
 },
 {
  "start": 326.32,
  "end": 328.28,
  "text": "信任就像婚姻里的空气"
 },
 {
  "start": 328.28,
  "end": 330.2,
  "text": "拥有的时候常常被忽略"
 },
 {
  "start": 330.2,
  "end": 331.12,
  "text": "一旦消失"
 },
 {
  "start": 331.12,
  "end": 332.4,
  "text": "只会让人窒息"
 },
 {
  "start": 332.4,
  "end": 333.68,
  "text": "没有信任的婚姻"
 },
 {
  "start": 333.68,
  "end": 335.28,
  "text": "如同没有地基的房子"
 },
 {
  "start": 335.28,
  "end": 336.32,
  "text": "摇摇欲坠"
 },
 {
  "start": 336.32,
  "end": 338.0,
  "text": "幸福更是无从说起"
 },
 {
  "start": 338.0,
  "end": 339.24,
  "text": "最后李安想说"
 },
 {
  "start": 339.24,
  "end": 340.88,
  "text": "婚姻遭遇信任危机"
 },
 {
  "start": 340.88,
  "end": 341.76,
  "text": "换个角度看"
 },
 {
  "start": 341.76,
  "end": 343.44,
  "text": "也是感情重塑的契机"
 },
 {
  "start": 343.44,
  "end": 345.56,
  "text": "只要两个人都愿意坚持往前走"
 },
 {
  "start": 345.56,
  "end": 347.16,
  "text": "度过难关之后的感情"
 },
 {
  "start": 347.16,
  "end": 348.32,
  "text": "往往会比从前"
 },
 {
  "start": 348.32,
  "end": 349.4,
  "text": "更加稳固"
 },
 {
  "start": 349.4,
  "end": 350.44,
  "text": "至深的痛苦"
 },
 {
  "start": 350.44,
  "end": 352.2,
  "text": "会催生两个人改变的决心"
 },
 {
  "start": 352.2,
  "end": 353.0,
  "text": "也让你们看清"
 },
 {
  "start": 353.0,
  "end": 354.92,
  "text": "婚姻里原本藏着的问题"
 },
 {
  "start": 354.92,
  "end": 356.36,
  "text": "倘若能够走出伤痛"
 },
 {
  "start": 356.36,
  "end": 357.56,
  "text": "化解隔阂"
 },
 {
  "start": 357.56,
  "end": 359.28,
  "text": "重新建立爱的连结"
 },
 {
  "start": 359.28,
  "end": 360.36,
  "text": "这份感情"
 },
 {
  "start": 360.36,
  "end": 362.36,
  "text": "会像久旱逢甘霖的草木"
 },
 {
  "start": 362.36,
  "end": 363.52,
  "text": "完成蜕变"
 },
 {
  "start": 363.52,
  "end": 364.88,
  "text": "变得牢不可破"
 },
 {
  "start": 364.88,
  "end": 366.84,
  "text": "李安向来劝和不劝离"
 },
 {
  "start": 366.84,
  "end": 368.4,
  "text": "婚姻感情里"
 },
 {
  "start": 368.4,
  "end": 370.24,
  "text": "无论遇上什么样的困惑"
 },
 {
  "start": 370.24,
  "end": 372.0,
  "text": "都可以来找李安聊聊"
 },
 {
  "start": 372.0,
  "end": 374.0,
  "text": "李安愿意认真听你的故事"
 },
 {
  "start": 374.0,
  "end": 375.24,
  "text": "陪你梳理出路"
 },
 {
  "start": 375.24,
  "end": 377.32,
  "text": "给你温暖的陪伴和坚定的支撑"
 }
]